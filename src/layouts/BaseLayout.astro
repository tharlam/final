---
// 1. IMPORT CLIENT ROUTER
import { ClientRouter } from 'astro:transitions';
import Header from "../components/nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/about-section.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
const BASE_PATH = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | Tharlam Academy</title>

        <ClientRouter />

        <link rel="manifest" href={`${BASE_PATH}site.webmanifest`} />
        <meta name="theme-color" content="#00152a" />
        <link rel="icon" type="image/svg+xml" href={`${BASE_PATH}favicon.svg`} />
        <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css" />
        <link rel="stylesheet" href={`${BASE_PATH}fa/css/all.min.css`} />

        <style is:global>
            /* FULL SCREEN OVERLAY */
            #initial-loader {
                position: fixed;
                inset: 0;
                background: #00152a; /* Your Brand Dark Blue */
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                z-index: 999999;
                transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            }

            /* CONTAINER FOR LINE AND TEXT */
            .loader-content {
                text-align: center;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 15px;
            }

            /* THE TRACK */
            .line-container {
                width: 280px;
                height: 2px;
                background: rgba(255, 255, 255, 0.05);
                border-radius: 4px;
                overflow: hidden;
            }

            /* THE REAL GREEN PROGRESS LINE */
            #progress-line {
                width: 0%;
                height: 100%;
                background: #00ff88; /* Your Brand Green */
                box-shadow: 0 0 15px rgba(0, 255, 136, 0.6);
                transition: width 0.4s cubic-bezier(0.1, 0.05, 0.1, 1);
            }

            /* PERCENTAGE TEXT */
            #percent-text {
                color: #00ff88;
                font-family: 'Inter', sans-serif;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 2px;
                text-transform: uppercase;
            }

            /* CLASS TO HIDE LOADER */
            .loader-hidden {
                opacity: 0;
                pointer-events: none;
            }
        </style>
    </head>

    <body>
        <div id="initial-loader">
            <div class="loader-content">
                <div class="line-container">
                    <div id="progress-line"></div>
                </div>
                <div id="percent-text">0%</div>
            </div>
        </div>

        <Header />
        <main>
            <div class="site-content-container">
                <slot />
            </div>
        </main>
        <Footer />

        <script is:inline define:vars={{ BASE_PATH }}>
            window.BASE_PATH = BASE_PATH;
        </script>

        <script is:inline>
            function runRealLoader() {
                const bar = document.getElementById('progress-line');
                const text = document.getElementById('percent-text');
                const wrapper = document.getElementById('initial-loader');

                if (!bar || !text || !wrapper) return;

                // 1. Start State
                wrapper.classList.remove('loader-hidden');
                bar.style.width = '0%';
                text.innerText = '0%';

                // 2. Track Real Resources
                // We estimate progress based on resource timing
                const resources = window.performance.getEntriesByType('resource');
                const totalResources = resources.length > 5 ? resources.length : 20; // estimate
                let loadedCount = 0;

                const updateUI = (percent) => {
                    bar.style.width = percent + '%';
                    text.innerText = percent + '%';
                };

                // Watch for new assets loading
                const observer = new PerformanceObserver((list) => {
                    const entries = list.getEntries();
                    loadedCount += entries.length;
                    let progress = Math.round((loadedCount / totalResources) * 90); // Cap at 90
                    if (progress < 90) updateUI(progress);
                });

                observer.observe({ entryTypes: ['resource'] });

                // 3. Final Finish (When window is fully ready)
                const finish = () => {
                    updateUI(100);
                    setTimeout(() => {
                        wrapper.classList.add('loader-hidden');
                        observer.disconnect();
                    }, 600);
                };

                if (document.readyState === 'complete') {
                    finish();
                } else {
                    window.addEventListener('load', finish, { once: true });
                }
            }

            // Execute on first page load
            runRealLoader();

            // Execute on every Astro internal page navigation
            document.addEventListener('astro:after-swap', runRealLoader);
        </script>

        <script src="https://unpkg.com/aos@2.3.4/dist/aos.js" defer></script>
        <script src={`${BASE_PATH}scripts/i18n-switcher.js`} defer type="module"></script>
        <script src={`${BASE_PATH}scripts/reinit.js`} defer type="module"></script>
    </body>
</html>