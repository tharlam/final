---
// src/layouts/BaseLayout.astro frontmatter
import Header from "../components/nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/about-section.css";

// Inside BaseLayout.astro frontmatter
interface Props {
    title: string;
    description?: string; // Changed to optional
    ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

// This variable will correctly hold the base path (/final/) defined in astro.config.mjs
const BASE_PATH = import.meta.env.BASE_URL;

// Generate absolute URLs for Open Graph (OG) tags and the canonical link
const absoluteUrl = Astro.url.href;

const absoluteOgImage = ogImage
    ? new URL(ogImage, Astro.site).href
    : new URL("/final/dezhung-rinpoche.jpg", Astro.site).href; // <-- CORRECTED PATH/CASE
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link rel="canonical" href={absoluteUrl} />

        <title>{title} | Tharlam Academy</title>

        <link
            rel="shortcut icon"
            href={`${BASE_PATH}favicon.ico`}
            type="image/x-icon"
        />

        <link
            rel="icon"
            href={`${BASE_PATH}favicon-16x16.png`}
            type="image/png"
            sizes="16x16"
        />

        <link
            rel="icon"
            href={`${BASE_PATH}favicon-32x32.png`}
            type="image/png"
            sizes="32x32"
        />

        <link
            rel="apple-touch-icon"
            href={`${BASE_PATH}apple-touch-icon.png`}
            type="image/png"
            sizes="180x180"
        />

        <link
            rel="icon"
            href={`${BASE_PATH}android-chrome-192x192.png`}
            type="image/png"
            sizes="192x192"
        />

        <link
            rel="icon"
            href={`${BASE_PATH}android-chrome-512x512.png`}
            type="image/png"
            sizes="512x512"
        />

        <link rel="manifest" href={`${BASE_PATH}site.webmanifest`} />

        <meta name="description" content={description} />
        <meta property="og:title" content={`${title} | Tharlam Academy`} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={absoluteUrl} />
        <meta property="og:image" content={absoluteOgImage} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={absoluteOgImage} />

        <link
            href="https://unpkg.com/aos@2.3.4/dist/aos.css"
            rel="stylesheet"
        />
        <link rel="stylesheet" href={`${BASE_PATH}fa/css/all.min.css`} />
    </head>

    <body>
        <Header />
        <main>
            <div class="site-content-container">
                <slot />
            </div>
        </main>
        <Footer />

        <script is:inline>
            window.BASE_PATH = "${BASE_PATH}";
        </script>

        <script src="https://unpkg.com/aos@2.3.4/dist/aos.js" defer></script>

        <script src={`${BASE_PATH}scripts/i18n-switcher.js`} defer type="module"
        ></script>

        <script src={`${BASE_PATH}scripts/reinit.js`} defer type="module"
        ></script>
    </body>
</html>
