---
// src/layouts/BaseLayout.astro frontmatter

// Import the necessary components
import Header from "../components/nav.astro";
import Footer from "../components/Footer.astro";

// Import global styles
import "../styles/global.css"; // your nav/global styles
import "../styles/global2.css"; // your new design system
import "../styles/about-section.css"; // section-specific styles

// Inside BaseLayout.astro frontmatter
interface Props {
    title: string;
}

const { title } = Astro.props;

// This variable will correctly hold the base path (/final/) defined in astro.config.mjs
const BASE_PATH = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title} | Tharlam Academy</title>

        {/* --- PROFESSIONAL FAVICON IMPLEMENTATION START --- */}

        {
            /* 1. PWA/Android Manifest Link & Theme Color (Essential for mobile) */
        }
        <link rel="manifest" href={`${BASE_PATH}site.webmanifest`} />
        <meta name="theme-color" content="#ffffff" />
        <meta name="apple-mobile-web-app-title" content="MyWebSite" />

        {/* 2. SVG Icon: Best quality, modern browsers (highest priority) */}
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${BASE_PATH}favicon.svg`}
        />

        {/* 3. Apple Touch Icon: Required for iOS Home Screen shortcut */}
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href={`${BASE_PATH}apple-touch-icon.png`}
        />

        {
            /* 4. PNG Icon Fallbacks: For specific browser sizes (e.g., Google SERPs) */
        }
        <link
            rel="icon"
            type="image/png"
            sizes="96x96"
            href={`${BASE_PATH}favicon-96x96.png`}
        />

        {
            /* 5. Legacy ICO Fallback: For older browsers (rel="shortcut icon" is obsolete) */
        }
        <link rel="icon" href={`${BASE_PATH}favicon.ico`} />

        {/* --- PROFESSIONAL FAVICON IMPLEMENTATION END --- */}

        <link
            href="https://unpkg.com/aos@2.3.4/dist/aos.css"
            rel="stylesheet"
        />
        <link rel="stylesheet" href={`${BASE_PATH}fa/css/all.min.css`} />
    </head>

    <body>
        <Header />
        <main>
            <div class="site-content-container">
                <slot />
            </div>
        </main>
        <Footer />

        <script is:inline>
            window.BASE_PATH = "${BASE_PATH}";
        </script>

        <script src="https://unpkg.com/aos@2.3.4/dist/aos.js" defer></script>

        <script src={`${BASE_PATH}scripts/i18n-switcher.js`} defer type="module"
        ></script>

        <script src={`${BASE_PATH}scripts/reinit.js`} defer type="module"
        ></script>
    </body>
</html>
