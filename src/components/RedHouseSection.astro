// src/components/RedHouseSection.astro
---

<section class="house-section red-house-section" data-aos="fade-up">
    <div class="container">
        <div class="house-content-grid">
            <div class="house-text" data-aos="fade-left">
                <p data-i18n="red_house_paragraph_1">
                    The **Red House (Chime House): Passion & Stamina**. The Red
                    House, also known as Chime House, signifies passion,
                    endurance, and boundless energy. Students in Red House are
                    renowned for their incredible stamina and fighting spirit,
                    making them powerhouses in long-distance and highly
                    competitive events. They approach every challenge with
                    intensity and fierce determination.
                </p>
                <p data-i18n="red_house_paragraph_2">
                    Red House promotes courage, resilience, and the relentless
                    pursuit of goals. Their strength is rooted in their ability
                    to push past limits, inspiring all members to commit fully
                    and never give up, embodying the true spirit of athleticism.
                </p>
                <div class="house-motto">
                    <strong>Motto:</strong> "Passion, Resilience, Endurance."
                </div>
            </div>

            <div class="house-image" data-aos="fade-right">
                <img
                    src="/final/ho-4.webp"
                    alt="Red House students demonstrating endurance and Chime House spirit"
                    class="responsive-image"
                    data-i18n-alt="red_house_image_alt"
                    loading="lazy"
                />
            </div>
        </div>
    </div>
</section>

<style>
    /* --- Component-Specific Styles --- */
    .red-house-section {
        background-color: #f8e8e8;
        padding: 70px 0;
    }

    /* CRITICAL DESKTOP FIX: Image on left, Text on right (Same as Yellow House) */
    .red-house-section .house-content-grid {
        flex-direction: row-reverse;
    }

    /* --- Essential Structural/General House CSS (Desktop/Base) --- */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }
    .house-content-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 60px;
        align-items: center;
        justify-content: center;
    }
    .house-text {
        flex: 1 1 450px;
        min-width: 300px;
        max-width: 550px;
        text-align: left;
    }
    .house-text p {
        font-size: 16px;
        line-height: 1.7;
        color: #444;
        margin-bottom: 20px;
    }
    .house-text p:first-child {
        font-size: 17px;
        color: #001f3f;
        font-weight: 500;
    }
    .house-image {
        flex: 1 1 350px;
        min-width: 300px;
        max-width: 550px;
        text-align: center;
    }
    .responsive-image {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
    .house-motto {
        font-style: italic;
        font-size: 16px;
        font-weight: 500;
        color: #001f3f;
        margin-top: 25px;
        padding: 10px 15px;
        background-color: rgba(0, 31, 63, 0.05);
        border-left: 4px solid #001f3f;
        border-radius: 4px;
    }

    /* ------------------------------------------------------------------ */
    /* --- MOBILE MEDIA QUERIES (Text on Top / Minimal Gap Fix) --- */
    /* ------------------------------------------------------------------ */

    @media (max-width: 992px) {
        .red-house-section {
            padding: 60px 0;
        }
        .house-content-grid {
            gap: 30px;
            flex-direction: column;
        } /* Reverts desktop row-reverse to standard column */
    }

    @media (max-width: 768px) {
        .red-house-section {
            padding: 40px 0;
        }
        .container {
            padding: 0 15px;
        }
        .house-content-grid {
            gap: 10px;
            flex-direction: column;
            align-items: center;
        }
        .house-text,
        .house-image {
            width: 100%;
            max-width: 500px;
        }

        /* CRITICAL FIX: Ensure minimal gap below text/above image */
        .house-image {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
        .house-image .responsive-image {
            margin-top: 0 !important;
            display: block;
        }

        .house-text p {
            font-size: 15px;
        }
        .house-text p:first-child {
            font-size: 16px;
        }
    }

    @media (max-width: 480px) {
        .red-house-section {
            padding: 30px 0;
        }
        .container {
            padding: 0 10px;
        }
        .house-content-grid {
            gap: 5px;
        }
        .house-image .responsive-image {
            display: block;
            margin-top: 0 !important;
        }
        .house-text p {
            font-size: 14px;
        }
        .house-text p:first-child {
            font-size: 15px;
        }
        .house-motto {
            font-size: 15px;
        }
    }
</style>
