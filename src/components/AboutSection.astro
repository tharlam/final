---
// Astro Component: AboutSection.astro
---

<section id="about" class="about-us-section">
  <div class="container">
    <h2 class="section-title" data-aos="fade-up" data-i18n="section_title">
      About Us
    </h2>
    <div class="about-content-grid">
      <div class="about-text" data-aos="fade-left">
        <p data-i18n="about_intro_paragraph">
          Tharlam Academy is a unique school dedicated to an education that
          seamlessly blends traditional Buddhist values with a modern,
          progressive curriculum. Our mission is to nurture well-rounded
          individuals who possess both intellectual prowess and a strong moral
          compass. The academy is providing a holistic learning environment that
          encourages critical thinking, creativity, and compassion.
        </p>
        <p data-i18n="about_vision_paragraph">
          Our vision is to empower the next generation of global citizens with
          the wisdom of the past and the skills of the future. We foster an
          atmosphere of respect, discipline, and ethical conduct, preparing
          students to face the challenges of the modern world while staying true
          to their spiritual heritage.
        </p>
        <div class="about-cta">
          <a
            href="/final/about"
            class="btn primary-btn"
            data-i18n="about_learn_more_button"
          >
            Learn More About Us
          </a>
        </div>
      </div>
      <div class="about-image" data-aos="fade-up">
        <img
          src="/final/house.webp"
          alt="about image alt"
          class="responsive-image"
          data-i18n-alt="about_image_alt"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* ======================================================= */
  /* --- GLOBAL VARIABLES (Maintain Consistency) --- */
  /* ======================================================= */
  :root {
    --primary-color: #001f3f;
    --text-color: #555;
    --heading-color: #001f3f;
    --bg-white: #ffffff;
    
    /* Layout Constants */
    --container-width: 1200px;
    --section-padding-desktop: 60px 0;
    --section-padding-tablet: 40px 0;
    --section-padding-mobile: 30px 0;
    
    /* Typography */
    --font-size-p: 17px;
    --line-height-p: 1.8;
  }

  /* ======================================================= */
  /* --- BASE STYLES (Desktop / Laptop) --- */
  /* ======================================================= */

  .about-us-section {
    padding: var(--section-padding-desktop);
    background-color: var(--bg-white);
    overflow: hidden; /* Prevents AOS animations from causing scrollbars */
  }

  .container {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 20px; /* Essential for mobile "breathing room" */
  }

  .section-title {
    font-size: 38px;
    font-weight: 700;
    color: var(--heading-color);
    text-align: center;
    margin-bottom: 40px;
  }

  .about-content-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 50px;
    align-items: flex-start;
  }

  .about-text {
    flex: 1.5; /* Takes up more space than the image */
    min-width: 300px;
  }

  .about-text p {
    font-size: var(--font-size-p);
    line-height: var(--line-height-p);
    margin-bottom: 22px;
    color: var(--text-color);
    
    /* Text Justification Logic */
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    word-break: break-word;
  }

  .about-image {
    flex: 1;
    min-width: 300px;
    text-align: center;
  }

  .about-image .responsive-image {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .about-cta {
    margin-top: 10px;
    text-align: left;
  }

  .btn {
    display: inline-block;
    padding: 14px 32px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  .primary-btn {
    background-color: var(--primary-color);
    color: white;
    border: 2px solid var(--primary-color);
  }

  .primary-btn:hover {
    background-color: #000;
    border-color: #000;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
  }

  /* ======================================================= */
  /* --- BREAKPOINT: 992px (Small Laptops) --- */
  /* ======================================================= */
  @media (max-width: 992px) {
    .section-title {
      font-size: 34px;
    }
    .about-content-grid {
      gap: 30px;
    }
  }

  /* ======================================================= */
  /* --- BREAKPOINT: 768px (Tablets) --- */
  /* ======================================================= */
  @media (max-width: 768px) {
    .about-us-section {
      padding: var(--section-padding-tablet);
    }
    .about-content-grid {
      flex-direction: column; /* Stack vertically */
      align-items: center;
    }
    .about-text {
      order: 2; /* Move text below the image for better mobile flow */
      width: 100%;
    }
    .about-image {
      order: 1;
      width: 100%;
      margin-bottom: 30px;
    }
    .section-title {
      font-size: 30px;
      margin-bottom: 25px;
    }
    .about-text p {
      font-size: 16px;
      text-align: justify; /* Maintain clean edges */
    }
  }

  /* ======================================================= */
  /* --- BREAKPOINT: 480px (Small Mobile) --- */
  /* ======================================================= */
  @media (max-width: 480px) {
    .about-us-section {
      padding: var(--section-padding-mobile);
    }
    .container {
      padding: 0 15px; /* Narrower padding for small screens */
    }
    .section-title {
      font-size: 26px;
    }
    .about-text p {
      font-size: 15px;
      line-height: 1.6;
    }
  }
</style>