---
// Import BASE_PATH for robust asset linking in Astro
const BASE_PATH = import.meta.env.BASE_URL;
---

<section class="sports-hero" id="sports-hero">
    <div class="container hero-content">
        <h1 data-i18n="sports_hero_title"></h1>

        <p class="sports-description" data-i18n="sports_p1"></p>

        <div class="hero-cta">
            <a
                href="#programs"
                class="btn-sports-outline"
                data-i18n="sports_btn"
            ></a>
        </div>
    </div>
</section>

<style>
    /* ======================================================= */
    /* --- Sports Hero Styles (Strict Section Root Only) --- */
    /* ======================================================= */

    .sports-hero {
        background-image:
            linear-gradient(var(--color-bg-dark-overlay), var(--color-bg-dark-overlay)),
            url("/final/football.webp");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;

        /* Using fluid section spacing tokens */
        padding: var(--space-section) 0;
        min-height: 400px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        width: 100%;
    }

    .hero-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: var(--color-text-white);
    }

    .sports-hero h1 {
        font-size: var(--font-heading);
        color: var(--color-text-white);
        margin-bottom: var(--spacing-md);
        line-height: 1.2;
        text-transform: uppercase;
        text-decoration: none;
    }

    /* Target the <strong> tag inside H1 if you want the title highlighted too */
    .sports-hero h1 strong {
        color: var(--color-accent-blue);
    }

    .sports-hero p {
        font-size: var(--font-body);
        line-height: var(--line-height-text);
        margin-bottom: var(--spacing-xl);
        color: rgba(255, 255, 255, 0.9);
        max-width: 800px;
        text-decoration: none;
    }

    /* This is what turns your JSON <strong> text into Blue */
    .sports-hero p strong {
        color: var(--color-accent-blue);
        font-weight: 700;
    }

    .btn-sports-outline {
        display: inline-block;
        padding: var(--spacing-md) var(--spacing-xxl);
        font-size: var(--font-body);
        font-weight: 600;
        color: var(--color-text-white);
        border: 2px solid var(--color-text-white);
        border-radius: 4px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-sports-outline:hover {
        background-color: var(--color-text-white);
        color: var(--color-primary); 
        transform: translateY(-2px);
        text-decoration: none;
        box-shadow: var(--shadow-medium);
    }

    @media (max-width: 480px) {
        .sports-hero {
            padding: var(--spacing-xxl) var(--space-container);
        }
    }
</style>