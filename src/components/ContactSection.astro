---
// src/components/ContactSection.astro
// UPDATED: Professional wide-card mobile layout
---

<section class="contact-section">
    <div class="container">
        
        <div class="header-content">
            <h2 class="contact-title" data-aos="fade-right" data-i18n="contact.title">
                Get In 
                <span class="highlight">Touch</span> 
                With Us
            </h2>
            <p class="contact-subtitle" data-aos="fade-right" data-aos-delay="50" data-i18n="contact.subtitle">
                We're ready to discuss your next project or answer any inquiries.
            </p>

            <div class="direct-contact-list" data-aos="fade-up" data-aos-delay="100">
                <div class="contact-item">
                    <span class="label" data-i18n="contact.address_label">Location</span>
                    <p data-i18n="contact.address">Boudha-6, Kathmandu, Nepal</p>
                </div>
                <div class="contact-item">
                    <span class="label" data-i18n="contact.email_label">Email</span>
                    <p>tharlamfamily@gmail.com</p>
                </div>
                <div class="contact-item">
                    <span class="label" data-i18n="contact.phone_label">Phone</span>
                    <p>+977-1-xxxxxxx</p>
                </div>
            </div>
        </div>

        <div class="form-wrapper" data-aos="fade-left" data-aos-delay="150">
            <div class="contact-card">
                <form id="astorContactForm" action="https://formspree.io/f/YOUR_ID" method="POST">
                    <div class="input-group">
                        <label data-i18n="contact.label_email">Email Address</label>
                        <input type="email" name="email" placeholder="example@mail.com" required />
                    </div>
                    
                    <div class="input-row">
                        <div class="input-group">
                            <label data-i18n="contact.label_name">Name</label>
                            <input type="text" name="name" placeholder="Your Name" required />
                        </div>
                        <div class="input-group">
                            <label data-i18n="contact.label_phone">Phone</label>
                            <input type="tel" name="phone" placeholder="Phone Number" />
                        </div>
                    </div>

                    <div class="input-group">
                        <label data-i18n="contact.label_message">Message</label>
                        <textarea name="message" placeholder="How can we help?"></textarea>
                    </div>

                    <button type="submit" class="submit-button">
                        <span data-i18n="contact.button_text">Submit Message</span>
                    </button>
                    
                    <p id="formStatus" class="form-status-msg"></p>
                </form>
            </div>
        </div>
    </div>
</section>

<style>
    /* --- Base Layout --- */
    .contact-section {
        padding: 80px 0;
        background-color: #f7f7f7;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0px;
        display: flex;
        gap: 60px;
        align-items: flex-start;
    }

    .header-content { flex: 1 1 35%; max-width: 4300px; }
    .form-wrapper { flex: 1 1 65%; max-width: 800px; }

    /* --- Typography --- */
    .contact-title {
        font-size: 38px;
        font-weight: 700;
        line-height: 1.2;
        color: #1a2a47;
        margin-bottom: 10px;
        text-align: left;
    }

    .contact-title .highlight {
        color: #1e87f0;
        display: block;
        text-align: left;
    }

    .contact-subtitle {
        font-size: 16px;
        color: #666;
        margin-bottom: 40px;
        line-height: 1.6;
        text-align: left;
    }

    .contact-item .label {
        font-size: 12px;
        font-weight: 700;
        color: #1e87f0;
        text-transform: uppercase;
        display: block;
        margin-bottom: 4px;
    }

    /* --- Form Card (The focus of your request) --- */
    .contact-card {
        background-color: #fff;
        border: 1px solid #eee;
        border-radius: 8px;
        padding: 40px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.03);
        transition: all 0.3s ease;
        width: 100%; /* Ensures it fills its wrapper */
    }

    .contact-card:hover {
        border-color: #1e87f0;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }

    /* --- Inputs & "No-Zoom" Fix --- */
    .input-group { margin-bottom: 20px; width: 100%; }
    .input-row { display: flex; gap: 20px; }

    label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #1a2a47;
        margin-bottom: 8px;
    }

    input, textarea {
        width: 100%;
        padding: 14px;
        border: 1px solid #eee;
        border-radius: 6px;
        background-color: #fcfcfc;
        font-size: 16px; /* Prevents mobile auto-zoom */
        color: #333;
        box-sizing: border-box;
    }

    input:focus, textarea:focus {
        border-color: #1e87f0;
        outline: none;
        background-color: #fff;
    }

    textarea { height: 130px; resize: none; }

    .submit-button {
        background-color: #1a2a47;
        color: white;
        padding: 16px 30px;
        border: none;
        border-radius: 6px;
        font-weight: 700;
        cursor: pointer;
        width: 100%;
        font-size: 16px;
        transition: 0.3s;
    }

    .submit-button:hover { background-color: #1e87f0; }

    /* --- PROFESSIONAL MOBILE WIDTH FIXES --- */

    @media (max-width: 992px) {
        .container { 
            flex-direction: column; 
            gap: 40px; 
            padding: 0 15px; /* Narrower padding to let card expand */
        }
        .header-content, .form-wrapper { 
            max-width: 100%; 
            width: 100%; 
        }
        .input-row { flex-direction: column; gap: 0; }
    }

    @media (max-width: 480px) {
        .contact-section { padding: 40px 0; }
        
        /* 1. This gives the card "Enough Width" on small screens */
        .container { 
            padding: 0 10px; 
        }

        /* 2. Tightens internal padding so inputs have more room */
        .contact-card { 
            padding: 25px 15px; 
        }

        .header-content { text-align: center; }
        .contact-title { font-size: 28px; }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("astorContactForm");
        const status = document.getElementById("formStatus");

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const data = new FormData(e.target);
            status.textContent = "Sending...";
            
            try {
                const response = await fetch(e.target.action, {
                    method: 'POST',
                    body: data,
                    headers: { 'Accept': 'application/json' }
                });
                if (response.ok) {
                    status.textContent = "Thank you! Message sent.";
                    status.style.color = "#1e87f0";
                    form.reset();
                } else {
                    status.textContent = "Error submitting form.";
                    status.style.color = "red";
                }
            } catch {
                status.textContent = "Connection error.";
                status.style.color = "red";
            }
        });
    });
</script>