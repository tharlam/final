---
const formId = "xzdveknw";
---

<section class="contact-section">
    <div class="container">
        <div class="header-content" data-aos="fade-up">
            <h2 class="contact-title">
                <span data-i18n="contact_title_prefix"></span>
                <span class="highlight" data-i18n="contact_title_highlight"
                ></span>
            </h2>
            <div class="direct-contact-list">
                <div class="contact-item">
                    <span class="label" data-i18n="contact_label_email"></span>
                    <p>mediatharlam@gmail.com</p>
                </div>
            </div>
        </div>

        <div class="form-wrapper">
            <div class="contact-card">
                <form id="astorContactForm">
                    <input type="text" name="_gotcha" style="display:none" />

                    <div class="input-row">
                        <div class="input-group">
                            <label data-i18n="contact_label_name"></label>
                            <input type="text" name="name" required />
                        </div>
                        <div class="input-group">
                            <label data-i18n="contact_label_email_addr"></label>
                            <input type="email" name="email" required />
                        </div>
                    </div>

                    <div class="input-row">
                        <div class="input-group">
                            <label data-i18n="contact_label_phone"></label>
                            <input type="tel" name="phone" />
                        </div>
                        <div class="input-group">
                            <label data-i18n="contact_label_address"></label>
                            <input type="text" name="address" />
                        </div>
                    </div>

                    <div class="input-group">
                        <label data-i18n="contact_label_message"></label>
                        <textarea name="message" required></textarea>
                    </div>

                    <button type="submit" id="submitBtn" class="submit-button">
                        <span id="btnText" data-i18n="contact_btn_send"></span>
                        <div id="btnSpinner" class="spinner hidden"></div>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div id="successModal" class="modal-overlay hidden">
        <div class="modal-content">
            <div class="success-icon">✓</div>
            <h3 data-i18n="contact_success_title"></h3>
            <p data-i18n="contact_success_text"></p>
            <button
                id="closeModal"
                class="close-btn"
                data-i18n="contact_btn_close"></button>
        </div>
    </div>
</section>

<script is:inline define:vars={{ formId }}>
    const form = document.getElementById("astorContactForm");
    const modal = document.getElementById("successModal");
    const btn = document.getElementById("submitBtn");
    const btnText = document.getElementById("btnText");
    const spinner = document.getElementById("btnSpinner");

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Get translation values or use fallbacks
        const sendingMsg =
            window.i18next?.t("contact_btn_sending") || "Sending...";
        const originalMsg =
            window.i18next?.t("contact_btn_send") || "Send Message";

        btn.disabled = true;
        btnText.textContent = sendingMsg;
        spinner.classList.remove("hidden");

        try {
            const response = await fetch(`https://formspree.io/f/${formId}`, {
                method: "POST",
                body: new FormData(form),
                headers: { Accept: "application/json" },
            });

            if (response.ok) {
                modal.classList.remove("hidden");
                form.reset();
            } else {
                alert("Submission failed. Please try again.");
            }
        } catch (err) {
            alert("Connection error.");
        } finally {
            btn.disabled = false;
            btnText.textContent = originalMsg;
            spinner.classList.add("hidden");
        }
    });

    document.getElementById("closeModal")?.addEventListener("click", () => {
        modal.classList.add("hidden");
    });
</script>

<style>
    /* CSS preserved exactly as before */
    .contact-section {
        padding: var(--space-section) 0;
        background-color: var(--color-text-white);
        width: 100%;
        position: relative;
    }
    .container {
        width: var(--container-width);
        max-width: var(--max-container);
        margin: 0 auto;
        padding: 0 var(--space-container);
        display: flex;
        gap: var(--space-gap);
    }
    .header-content {
        flex: 1;
    }
    .form-wrapper {
        flex: 1.5;
        width: 100%;
    }
    .contact-title {
        font-size: var(--font-heading);
        color: var(--color-heading);
        margin-bottom: var(--space-small);
    }
    .contact-title .highlight {
        color: var(--color-accent-blue);
    }
    .label {
        font-size: 12px;
        font-weight: 700;
        color: var(--color-accent-blue);
        text-transform: uppercase;
        display: block;
        margin-bottom: 4px;
    }
    .contact-item {
        margin-bottom: var(--space-small);
    }
    .contact-card {
        background: var(--color-text-white);
        border: 1px solid var(--border-light-blue);
        border-radius: 8px;
        padding: clamp(15px, 4vw, 40px);
        box-shadow: var(--shadow-light);
    }
    .input-row {
        display: flex;
        gap: 20px;
        margin-bottom: 15px;
    }
    .input-group {
        margin-bottom: 15px;
        width: 100%;
    }
    label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--color-heading);
    }
    input,
    textarea {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 15px;
        background: #fcfcfc;
        box-sizing: border-box;
        font-family: inherit;
    }
    textarea {
        height: 100px;
        resize: none;
    }
    .submit-button {
        background-color: var(--color-primary);
        color: var(--color-text-white);
        padding: 16px;
        border: none;
        border-radius: 6px;
        width: 100%;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        transition: 0.3s;
    }
    .submit-button:hover {
        background-color: var(--color-btn-hover);
    }
    .spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 0.7s linear infinite;
    }
    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }
    .modal-content {
        background: white;
        padding: 40px;
        border-radius: 12px;
        text-align: center;
        max-width: 400px;
        width: 90%;
        transform: scale(0.8);
        animation: popIn 0.3s forwards;
    }
    .success-icon {
        width: 60px;
        height: 60px;
        background: #4caf50;
        color: white;
        font-size: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }
    .close-btn {
        margin-top: 20px;
        padding: 10px 25px;
        background: var(--color-primary);
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }
    .hidden {
        display: none !important;
    }
    @media (max-width: 768px) {
        .container {
            flex-direction: column;
        }
        .input-row {
            flex-direction: column;
            gap: 0;
        }
    }
</style>
