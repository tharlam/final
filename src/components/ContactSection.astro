---
// src/components/Contact.astro
// FINAL CODE: Matches Screenshot Design (Deep Blue Palette, No Map, 1280px Max-Width).
---

<section id="contact" class="contact-section-new">
    <div class="container">
        <header class="contact-header" data-aos="fade-up">
            <p class="contact-subheading" data-i18n="contact_subheading">
                HAVE A QUESTION?
            </p>
            <h2 class="contact-title" data-aos-delay="100" data-i18n="contact_title">
                Connect with <span class="highlight">Tharlam Academy</span>
            </h2>
        </header>

        <div class="contact-content-grid">

            <div class="contact-info-card" data-aos="fade-right" data-aos-delay="200">
                <h3 data-i18n="contact_details_heading">Direct Contact Details</h3>
                <p class="info-description" data-i18n="contact_details_desc">
                    Prefer speaking directly? Use the information below to reach our administration.
                </p>

                <ul class="info-list">
                    <li>
                        <i class="fas fa-phone-alt"></i>
                        <a href="tel:9812127271">9812127271</a>
                    </li>
                    <li>
                        <i class="fas fa-envelope"></i>
                        <a href="mailto:tharlamacademy@gmail.com">tharlamacademy@gmail.com</a>
                    </li>
                    <li>
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Nepal, Kathmandu, Boudha 6</span>
                    </li>
                </ul>

                <a href="https://wa.me/9812127271" target="_blank" class="whatsapp-btn" data-i18n="contact_whatsapp_btn">
                    <i class="fab fa-whatsapp"></i> Chat on WhatsApp
                </a>
            </div>
            
            <div class="contact-form-wrapper" data-aos="fade-left" data-aos-delay="200">
                <form
                    class="contact-form"
                    action="https://formspree.io/f/mgvkpwbd"
                    method="POST"
                >
                    <div class="form-row">
                        <div class="form-group">
                            <label for="full_name" data-i18n="form_label_name">FULL NAME *</label>
                            <input type="text" id="full_name" name="full_name" required placeholder="John Doe" />
                        </div>
                        <div class="form-group">
                            <label for="email_address" data-i18n="form_label_email">EMAIL ADDRESS *</label>
                            <input type="email" id="email_address" name="email_address" required placeholder="you@example.com" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="phone_number" data-i18n="form_label_phone">PHONE NUMBER</label>
                            <input type="tel" id="phone_number" name="phone_number" placeholder="(+977) 98XXXXXXXX" />
                        </div>
                        <div class="form-group">
                            <label for="inquiry_type" data-i18n="form_label_inquiry">INQUIRY TYPE</label>
                            <select id="inquiry_type" name="inquiry_type">
                                <option value="" selected disabled hidden>Select Inquiry Type</option>
                                <option value="admissions" data-i18n="inquiry_admissions">Admissions</option>
                                <option value="academic" data-i18n="inquiry_academic">Academic Programs</option>
                                <option value="support" data-i18n="inquiry_support">Support/Donations</option>
                                <option value="general" data-i18n="inquiry_general">General Inquiry</option>
                            </select>
                        </div>
                    </div>
        
                    <div class="form-group">
                        <label for="your_message" data-i18n="form_label_message">YOUR MESSAGE *</label>
                        <textarea id="your_message" name="your_message" rows="5" required placeholder="How can we help you?"></textarea>
                    </div>

                    <button type="submit" class="submit-btn" data-i18n="form_button_submit">
                        SEND MESSAGE <i class="fas fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<style>
    /* --- Section Setup (White Background, Dark Text) --- */
    .contact-section-new {
        padding: 100px 20px;
        background-color: #ffffff;
        color: #1e293b; 
        text-align: center;
    }

    .contact-section-new .container {
        /* Confirmed Max Width: 1280px */
        max-width: 1200px;
        margin: 0 auto;
    }

    /* --- Header Styling --- */
    .contact-section-new .contact-header {
        margin-bottom: 60px;
    }

    .contact-section-new .contact-subheading {
        text-transform: uppercase;
        /* ADJUSTED: Slightly smaller */
        font-size: 0.85rem; 
        /* Deep Blue */
        color: #001f3f; 
        letter-spacing: 2px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .contact-section-new .contact-title {
        /* ADJUSTED: Main desktop size reduced from 3rem to 2.5rem */
        font-size: 2.5rem; 
        font-weight: 800;
        line-height: 1.1;
    }

    .contact-section-new .contact-title .highlight {
        /* Deep Blue */
        color: #001f3f; 
    }

    /* --- Grid Layout for Content --- */
    .contact-section-new .contact-content-grid {
        display: grid;
        grid-template-columns: 1fr 2fr; 
        gap: 30px;
        /* Updated max-width to 1280px as requested */
        max-width: 1200px; 
        margin: 0 auto;
        text-align: left;
    }

    /* ==================================== */
    /* --- 1. Info Card Styling --- */
    /* ==================================== */
    .contact-section-new .contact-info-card {
        /* Deep Blue Palette */
        background-color: #001f3f; 
        background-image: linear-gradient(135deg, #001f3f 0%, #00002b 100%); 
        padding: 40px;
        border-radius: 12px;
        color: #f1f5f9; 
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .contact-section-new .contact-info-card h3 {
        /* ADJUSTED: Card Heading size reduced from 1.5rem to 1.4rem */
        color: #f1f5f9;
        font-size: 1.4rem;
    }
    
    .contact-section-new .contact-info-card .info-list a,
    .contact-section-new .contact-info-card .info-list span {
        color: #f1f5f9;
        /* ADJUSTED: Info List text size reduced from 1rem to 0.95rem */
        font-size: 0.95rem; 
    }

    .contact-section-new .whatsapp-btn {
        background-color: #25d366; 
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px 20px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        /* ADJUSTED: Button text reduced from 1rem to 0.95rem */
        font-size: 0.95rem; 
        margin-top: 30px;
    }
    .contact-section-new .whatsapp-btn:hover {
        background-color: #128c7e;
    }
    .contact-section-new .whatsapp-btn i {
        margin-right: 8px;
    }

    /* ==================================== */
    /* --- 2. Form Styling --- */
    /* ==================================== */
    .contact-section-new .contact-form-wrapper {
        background-color: #f8fafc;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .contact-section-new .contact-form label {
        color: #1e293b; 
        font-weight: 600;
        /* ADJUSTED: Form label reduced from 0.85rem to 0.8rem */
        font-size: 0.8rem; 
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .contact-section-new .contact-form input,
    .contact-section-new .contact-form select,
    .contact-section-new .contact-form textarea {
        color: #1e293b; 
        background-color: white;
        width: 100%;
        padding: 12px 15px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        /* ADJUSTED: Input text reduced from 1rem to 0.95rem */
        font-size: 0.95rem; 
        box-sizing: border-box;
    }
    .contact-section-new .contact-form input:focus,
    .contact-section-new .contact-form select:focus,
    .contact-section-new .contact-form textarea:focus {
        /* Deep Blue for focus */
        border-color: #001f3f; 
        box-shadow: 0 0 0 3px rgba(0, 31, 63, 0.2); 
        outline: none;
    }
    .contact-section-new .contact-form .form-row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
    }


    .contact-section-new .contact-form .submit-btn {
        /* Deep Blue Button */
        background-color: #001f3f; 
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 14px 30px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        /* ADJUSTED: Submit button text reduced from 1rem to 0.95rem */
        font-size: 0.95rem; 
        font-weight: 700;
        margin-top: 25px;
        text-transform: uppercase;
    }
    .contact-section-new .contact-form .submit-btn:hover {
        /* Black hover */
        background-color: black; 
        transform: translateY(-1px);
    }

    /* ==================================== */
    /* --- Responsive Adjustments --- */
    /* ==================================== */

    /* Tablet and Small Desktop (992px) */
    @media (max-width: 992px) {
        .contact-section-new {
            padding-top: 50px;
            padding-bottom: 50px;
        }
        .contact-section-new .contact-content-grid {
            grid-template-columns: 1fr; 
            gap: 40px;
        }
        .contact-section-new .contact-title {
            /* ADJUSTED: Proportional reduction */
            font-size: 2.2rem; 
        }
        .contact-section-new .contact-info-card,
        .contact-section-new .contact-form-wrapper {
            padding: 30px;
        }
        .contact-section-new .whatsapp-btn {
            width: 100%;
        }
    }

    /* Mobile (768px) */
    @media (max-width: 768px) {
        .contact-section-new {
            padding-top: 30px;
            padding-bottom: 30px;
        }
        .contact-section-new .contact-title {
            /* ADJUSTED: Proportional reduction */
            font-size: 1.8rem; 
        }
        .contact-section-new .contact-form .form-row {
            flex-direction: column;
            gap: 0;
        }
        .contact-section-new .contact-form .form-group {
            margin-bottom: 20px;
        }
    }

    /* Smallest Mobile (480px) */
    @media (max-width: 480px) {
        .contact-section-new {
            padding-top: 20px;
        }
        .contact-section-new .contact-title {
            /* ADJUSTED: Proportional reduction */
            font-size: 1.5rem; 
        }
    }
</style>