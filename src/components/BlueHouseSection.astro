// src/components/BlueHouseSection.astro
---

<section class="house-section blue-house-section" data-aos="fade-up">
    <div class="container">
        <div class="house-content-grid">
            <div class="house-text" data-aos="fade-left">
                <p data-i18n="blue_house_paragraph_1">
                    The **Blue House (Ghaden House): Calm & Collaboration**. The
                    Blue House, also known as Ghaden House, represents calm
                    composure, strategic thinking, and unparalleled
                    collaboration. Students in Blue House excel in team sports
                    where communication and tactical play are key. Their ability
                    to work seamlessly together makes them formidable opponents
                    and supportive teammates.
                </p>
                <p data-i18n="blue_house_paragraph_2">
                    Blue House emphasizes mutual respect, understanding, and the
                    power of collective effort. They teach that true strength
                    lies in unity and the ability to adapt as a cohesive unit,
                    fostering a deep sense of camaraderie among its members.
                </p>
                <div class="house-motto">
                    <strong>Motto:</strong> "Calm, Strategy, Unity."
                </div>
            </div>

            <div class="house-image" data-aos="fade-right">
                <img
                    src="/final/ho-1.webp"
                    alt="Blue House students demonstrating teamwork and Ghaden House spirit"
                    class="responsive-image"
                    data-i18n-alt="blue_house_image_alt"
                    loading="lazy"
                />
            </div>
        </div>
    </div>
</section>

<style>
    /* --- Component-Specific Styles --- */
    .blue-house-section {
        background-color: #f0f8ff;
        padding: 70px 0;
    }

    /* CRITICAL DESKTOP FIX: Image on left, Text on right (Same as Yellow House) */
    .blue-house-section .house-content-grid {
        flex-direction: row-reverse;
    }

    /* --- Essential Structural/General House CSS (Desktop/Base) --- */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }
    .house-content-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 60px;
        align-items: center;
        justify-content: center;
    }
    .house-text {
        flex: 1 1 450px;
        min-width: 300px;
        max-width: 550px;
        text-align: left;
    }
    .house-text p {
        font-size: 16px;
        line-height: 1.7;
        color: #444;
        margin-bottom: 20px;
    }
    .house-text p:first-child {
        font-size: 17px;
        color: #001f3f;
        font-weight: 500;
    }
    .house-image {
        flex: 1 1 350px;
        min-width: 300px;
        max-width: 550px;
        text-align: center;
    }
    .responsive-image {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
    .house-motto {
        font-style: italic;
        font-size: 16px;
        font-weight: 500;
        color: #001f3f;
        margin-top: 25px;
        padding: 10px 15px;
        background-color: rgba(0, 31, 63, 0.05);
        border-left: 4px solid #001f3f;
        border-radius: 4px;
    }

    /* ------------------------------------------------------------------ */
    /* --- MOBILE MEDIA QUERIES (Text on Top / Minimal Gap Fix) --- */
    /* ------------------------------------------------------------------ */

    @media (max-width: 992px) {
        .blue-house-section {
            padding: 60px 0;
        }
        .house-content-grid {
            gap: 30px;
            flex-direction: column;
        } /* Reverts desktop row-reverse to standard column */
    }

    @media (max-width: 768px) {
        .blue-house-section {
            padding: 40px 0;
        }
        .container {
            padding: 0 15px;
        }
        .house-content-grid {
            gap: 10px;
            flex-direction: column;
            align-items: center;
        }
        .house-text,
        .house-image {
            width: 100%;
            max-width: 500px;
        }

        /* CRITICAL FIX: Ensure minimal gap below text/above image */
        .house-image {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
        .house-image .responsive-image {
            margin-top: 0 !important;
            display: block;
        }

        .house-text p {
            font-size: 15px;
        }
        .house-text p:first-child {
            font-size: 16px;
        }
    }

    @media (max-width: 480px) {
        .blue-house-section {
            padding: 30px 0;
        }
        .container {
            padding: 0 10px;
        }
        .house-content-grid {
            gap: 5px;
        }
        .house-image .responsive-image {
            display: block;
            margin-top: 0 !important;
        }
        .house-text p {
            font-size: 14px;
        }
        .house-text p:first-child {
            font-size: 15px;
        }
        .house-motto {
            font-size: 15px;
        }
    }
</style>
