<style>
  /* --- Facilities Section (Tabbed Grid Layout) --- */

  /* Main Section Container */
  .facilities-tabbed-grid-section {
    padding: 30px 20px;
    background-color: #f8f8f8;
    color: #333;
    overflow: hidden;
    text-align: center;
  }

  /* Section Header */
  .facilities-header {
    max-width: 1200px;
    margin: 30px auto 30px auto;
    padding: 10px;
  }

  /* H2 Title: .section-title handles font-size/weight globally */
  .facilities-title {
    color: #001f3f;
    margin-bottom: 15px;
    position: relative;
    padding-bottom: 12px;
  }

  /* Title Highlight Styling */
  .facilities-title .highlight-blue {
    color: #007bff;
    font-weight: 700;
  }

  .facilities-title::after {
    /* Design preserved */
    content: "";
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 0;
    width: 80px;
    height: 4px;
    background-color: #001f3f;
    border-radius: 2px;
  }

  /* Subtitle: .consistent-paragraph-text handles font-size/line-height globally */
  .facilities-subtitle {
    margin-top: 15px;
    color: #555;
  }

  /* Tab Buttons Container (Design Preservation) */
  .facilities-tabs-container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 40px;
    border-bottom: 2px solid #e0e0e0;
    padding-bottom: 15px;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
  }

  .tab-btn {
    background-color: transparent;
    border: none;
    padding: 10px 20px;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
    position: relative;
    color: #6c757d; /* Softer color when inactive */
    transition:
      color 0.3s ease,
      background-color 0.3s ease,
      box-shadow 0.3s ease;
    border-radius: 6px;
  }

  /* 🌟 ENHANCED HOVER 🌟 */
  .tab-btn:hover {
    color: #001f3f;
    background-color: #e9ecef; /* Subtle light background on hover */
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05); /* Very light shadow on hover */
  }

  /* Active state */
  .tab-btn.active {
    color: #001f3f;
    background-color: white;
    /* Stronger shadow using primary blue */
    box-shadow: 0 4px 12px rgba(0, 31, 63, 0.15);
    border-radius: 6px 6px 0 0; /* Flat bottom border to meet the line */
  }

  .tab-btn.active::after {
    content: "";
    position: absolute;
    bottom: -17px;
    left: 50%;
    transform: translateX(-50%);
    width: 100%; /* Wider underline for active tab */
    height: 3px;
    background-color: #001f3f;
    border-radius: 2px;
  }

  /* Facilities Grid Content (Layout Preservation) */
  .facilities-grid-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    max-width: 1215px;
    margin: 0 auto;
    padding: 0 0px;

    /* 🌟 FOUC FIX: Initially hide the container 🌟 */
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  /* 🌟 FOUC FIX: This forces all cards to be hidden before JS runs 🌟 */
  .facilities-grid-content.hidden-by-default .facility-card {
    display: none !important;
  }

  /* 🌟 FOUC FIX: This ensures the DEFAULT cards are shown by the CSS 🌟 */
  .facilities-grid-content.hidden-by-default
    .facility-card[data-category="academic"] {
    display: flex !important; /* Overrides the 'display: none' above */
  }

  /* 🌟 FOUC FIX: Reveals the container after JS removes the class 🌟 */
  .facilities-grid-content:not(.hidden-by-default) {
    opacity: 1;
  }

  .facility-card {
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    cursor: pointer;
    /* Added subtle border for definition */
    border: 1px solid #e0e0e0;
  }

  .facility-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15); /* Slightly darker shadow on hover */
  }

  .card-image-placeholder {
    width: 100%;
    padding-bottom: 66.66%;
    position: relative;
    overflow: hidden;
    background-color: #f0f0f0;
  }

  .card-image-placeholder img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .facility-card:hover .card-image-placeholder img {
    transform: scale(1.08);
  }

  /* Card Title (Design Preservation) */
  .card-title {
    font-size: 19px;
    font-weight: 600;
    color: #001f3f;
    padding: 18px 15px;
    text-align: center;
    background-color: #ffffff;
    border-top: 1px solid #f0f0f0;
    transition: color 0.3s ease; /* Added transition */
  }

  /* Title color change on card hover */
  .facility-card:hover .card-title {
    color: #007bff; /* Primary blue on hover */
  }

  /* Hidden and Visible states for cards */
  .facility-card.hidden {
    display: none !important;
  }

  .facility-card.visible {
    display: flex;
  }

  /* --- Responsive Adjustments (Sizing Changes Only) --- */

  /* Tablets and smaller desktops (max-width: 992px) */
  @media (max-width: 992px) {
    .facilities-tabbed-grid-section {
      padding: 0 15px;
    }

    .facilities-title {
      margin-bottom: 40px;
    }

    .facilities-tabs-container {
      gap: 10px;
      padding-bottom: 12px;
      margin-bottom: 30px;
    }

    .tab-btn {
      padding: 8px 15px;
      font-size: 16px;
    }

    .tab-btn.active {
      box-shadow: 0 2px 8px rgba(0, 31, 63, 0.1);
    }

    .facilities-grid-content {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .card-image-placeholder {
      padding-bottom: 75%;
    }

    .card-title {
      font-size: 17px;
      padding: 15px 12px;
    }
  }

  /* Mobile devices (max-width: 768px) */
  @media (max-width: 768px) {
    .facilities-tabbed-grid-section {
      padding: 0 10px;
    }

    .facilities-header {
      margin-bottom: 30px;
    }

    .facilities-title {
      margin-bottom: 10px;
    }

    /* Mobile tabs stack vertically and don't need the underline design */
    .facilities-tabs-container {
      margin-bottom: 25px;
      flex-direction: column;
      gap: 8px;
      padding-bottom: 10px;
      border-bottom: none;
    }

    .tab-btn {
      font-size: 15px;
      width: 100%;
      text-align: center;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
    }

    .tab-btn.active {
      border-color: #001f3f;
      background-color: #f0f0f0; /* Less distracting on mobile when active */
      box-shadow: none; /* Remove shadow on mobile */
    }

    .tab-btn.active::after {
      display: none;
    }

    /* GRID: Mobile carousel design */
    .facilities-grid-content {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      gap: 20px;
    }

    /* Hides the scrollbar for a cleaner look */
    .facilities-grid-content::-webkit-scrollbar {
      display: none;
    }
    .facilities-grid-content {
      scrollbar-width: none;
    }

    .facility-card {
      flex-shrink: 0;
      width: 85%;
      max-width: 350px;
      scroll-snap-align: center;
    }

    /* Very small mobile devices (max-width: 480px) */
    @media (max-width: 480px) {
      .facilities-tabbed-grid-section {
        padding: 0 5px;
      }

      .facilities-header {
        margin-bottom: 20px;
      }

      .facilities-tabs-container {
        gap: 6px;
        margin-bottom: 20px;
      }

      .tab-btn {
        font-size: 14px;
        padding: 8px 12px;
      }

      .facilities-grid-content {
        gap: 15px;
      }

      .facility-card {
        width: 90%;
        max-width: 300px;
      }

      .card-title {
        font-size: 16px;
        padding: 12px 10px;
      }
    }
  }
</style>

<script is:inline>
  function initializeFacilitiesTabs() {
    // --- 1. Element Selection ---
    const tabButtons = document.querySelectorAll(
      ".facilities-tabs-container .tab-btn",
    );
    const facilityCards = document.querySelectorAll(
      ".facilities-grid-content .facility-card",
    );
    const gridContent = document.querySelector(".facilities-grid-content");

    // --- 2. Filter Function (Helper) ---
    const filterFacilities = (category) => {
      facilityCards.forEach((card) => {
        const cardCategory = card.dataset.category;

        if (category === "all" || cardCategory === category) {
          card.classList.remove("hidden");
          card.classList.add("visible");
        } else {
          card.classList.remove("visible");
          card.classList.add("hidden");
        }
      });

      // FIX for Mobile Carousel: Force scroll reset after filter
      if (gridContent) {
        gridContent.scrollLeft = 0;
      }
    };

    // --- 3. Event Listener Setup ---
    const handleTabClick = (event) => {
      const button = event.currentTarget;
      tabButtons.forEach((btn) => btn.classList.remove("active"));
      button.classList.add("active");
      const category = button.dataset.category;
      filterFacilities(category);
    };

    tabButtons.forEach((button) => {
      button.removeEventListener("click", handleTabClick);
      button.addEventListener("click", handleTabClick);
    });

    // --- 4. Default Activation (Modified) ---
    const academicTabButton = document.querySelector(
      '.facilities-tabs-container .tab-btn[data-category="academic"]',
    );

    if (academicTabButton) {
      // Run the filter logic immediately
      // We use click() here for simplicity, but filterFacilities('academic') works too.
      academicTabButton.click();

      // Remove the CSS class to smoothly reveal the now-filtered content
      if (gridContent) {
        // Use setTimeout to allow any AOS/filter processing to finish before revealing
        setTimeout(() => {
          gridContent.classList.remove("hidden-by-default");
        }, 100);
      }
    }
  }

  // --- EXECUTION TRIGGERS ---
  document.addEventListener("DOMContentLoaded", initializeFacilitiesTabs);
  document.addEventListener("astro:page-load", initializeFacilitiesTabs);
</script>
