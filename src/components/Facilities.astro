<style>
  /* --- Section Base --- */
  .facilities-tabbed-grid-section {
    padding: var(--space-section) 0;
    background-color: #f9f9f9;
    color: var(--color-text-dark);
    text-align: center;
  }

  .facilities-header {
    max-width: var(--max-container);
    margin: 0 auto var(--space-section);
    padding: 0 var(--spacing-xl);
  }

  /* --- Strict Typography Rules --- */
  .facilities-title {
    color: var(--color-heading);
    font-size: var(--font-heading); /* Strict Fluid Heading */
    line-height: 1.2;
    margin-bottom: var(--spacing-md);
    position: relative;
    display: inline-block;
    padding-bottom: var(--spacing-sm);
  }

  .facilities-title::after {
    content: "";
    position: absolute;
    bottom: 0; left: 50%; transform: translateX(-50%);
    width: 60px; height: 4px;
    background-color: var(--color-primary);
    border-radius: 2px;
  }

  .facilities-subtitle {
    color: var(--color-text);
    font-size: var(--font-body); /* Strict Fluid Body */
    line-height: var(--line-height-text);
    max-width: 800px;
    margin: 0 auto;
  }

  /* --- Tabs System --- */
  .facilities-tabs-wrapper {
    overflow-x: auto;
    scrollbar-width: none;
    margin-bottom: var(--space-section);
    padding: 0 var(--spacing-xl);
  }
  .facilities-tabs-wrapper::-webkit-scrollbar { display: none; }

  .facilities-tabs-container {
    display: inline-flex;
    gap: var(--space-gap);
    border-bottom: 1px solid #ddd;
    padding-bottom: var(--spacing-sm);
  }

  .tab-btn {
    white-space: nowrap;
    background: none; border: none;
    padding: var(--spacing-sm) var(--spacing-lg);
    font-size: var(--font-body); /* Matches site font size */
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    transition: 0.3s ease;
  }

  .tab-btn.active {
    color: var(--color-primary);
    border-bottom: 3px solid var(--color-primary);
  }

  /* --- Grid & Cards --- */
  .facilities-grid-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-gap); /* Fluid gap from root */
    max-width: var(--max-container);
    margin: 0 auto;
    padding: 0 var(--spacing-xl);
    transition: opacity 0.4s ease;
  }

  .facilities-grid-content.hidden-by-default { opacity: 0; }
  .facility-card.hidden { display: none !important; }

  .facility-card {
    background-color: var(--color-text-white);
    border-radius: 12px;
    box-shadow: var(--shadow-light);
    border: 1px solid #eee;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .facility-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-medium);
  }

  .card-image-placeholder { aspect-ratio: 3/2; overflow: hidden; }
  .card-image-placeholder img { width: 100%; height: 100%; object-fit: cover; }

  .card-title {
    padding: var(--spacing-lg);
    color: var(--color-primary);
    font-size: var(--font-body); /* Strict Body font for consistency */
    font-weight: 700;
    line-height: 1.2;
  }

  /* --- Responsive Betterment (Horizontal Swipe) --- */
  @media (max-width: 992px) {
    .facilities-grid-content {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 0 var(--spacing-xl) var(--spacing-xxl);
      gap: var(--spacing-lg);
      scrollbar-width: none;
    }
    .facilities-grid-content::-webkit-scrollbar { display: none; }

    .facility-card {
      flex: 0 0 95%; /* Allows the next card to peek from the side */
      scroll-snap-align: center;
    }
  }
</style>

<script is:inline>
  function initFacilities() {
    const tabs = document.querySelectorAll('.tab-btn');
    const cards = document.querySelectorAll('.facility-card');
    const grid = document.querySelector('.facilities-grid-content');

    if (!grid) return;

    function filter(cat) {
      cards.forEach(c => {
        c.classList.toggle('hidden', c.dataset.category !== cat);
      });
      grid.scrollLeft = 0;
    }

    tabs.forEach(t => {
      t.addEventListener('click', () => {
        tabs.forEach(btn => btn.classList.remove('active'));
        t.classList.add('active');
        filter(t.dataset.category);
      });
    });

    filter('academic'); // Default view
    grid.classList.remove('hidden-by-default');
  }

  document.addEventListener("DOMContentLoaded", initFacilities);
  document.addEventListener("astro:page-load", initFacilities);
</script>