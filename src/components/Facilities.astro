    }

    .card-title {
      /* CONSISTENCY: Adjusted to fit the consistent range */
      font-size: 17px;
      padding: 15px 12px;
    }
  }

  /* Mobile devices (max-width: 768px) */
  @media (max-width: 768px) {
    .facilities-tabbed-grid-section {
      /* CONSISTENCY: Remove conflicting vertical padding, rely on .site-section */
      padding: 0 10px;
    }

    .facilities-header {
      /* CONSISTENCY: Adjusted margin to match global vertical flow */
      margin-bottom: 30px;
    }

    .facilities-title {
