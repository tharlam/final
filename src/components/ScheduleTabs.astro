<style>
    /* --- Interactive Tabs Section --- */
.interactive-tabs-section {
  padding: var(--space-section) 0;
  background-color: var(--color-section-bg, var(--background-light));
}

/* Desktop Layout */
.interactive-tabs-grid {
  display: flex;
  flex-direction: row;
  gap: var(--space-gap);
  max-width: var(--max-container);
  margin: 0 auto;
  padding: var(--space-container);
}

/* Tabs Navigation */
.tabs-navigation {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  width: 220px;
  background-color: var(--color-text-white);
  border-radius: var(--space-small);
  padding: var(--space-small) 0;
  box-shadow: var(--shadow-light);
  height: fit-content;
}

.tab-button {
  flex-shrink: 0;
  padding: var(--space-small) var(--space-gap);
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text);
  background-color: transparent;
  border: none;
  text-align: left;
  border-left: 3px solid transparent;
  cursor: pointer;
  transition: all 0.3s ease;
  border-radius: 9px; /* 🔹 slight rounded edge */
}

.tab-button.active {
  color: var(--color-text-white);
  font-weight: 700;
  border-left: 3px solid var(--color-primary);
  background-color: var(--color-primary);
  border-radius: 9px; /* 🔹 keep consistent when active */
}


.tab-button.active {
  color: var(--color-text-white);
  font-weight: 700;
  border-left: 3px solid var(--color-primary);
  background-color: var(--color-primary);
}

/* Tab Content */
.tabs-content-wrapper {
  flex-grow: 1;
  background-color: var(--color-text-white);
  padding: var(--space-gap);
  border-radius: var(--space-small);
  box-shadow: var(--shadow-light);
  min-height: 400px;
}

.tab-panel-title {
  font-size: var(--font-heading);
  color: var(--color-heading);
  margin-bottom: var(--space-small);
  border-bottom: 2px solid var(--border-light-blue, #e0e0e0);
  padding-bottom: var(--space-small);
}

.tab-panel-intro {
  font-size: var(--font-body);
  color: var(--color-text);
  line-height: var(--line-height-text);
  margin-bottom: var(--space-gap);
}

/* Table Styling */
.daily-schedule-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: var(--space-small);
  font-size: var(--font-body);
}

.daily-schedule-table th,
.daily-schedule-table td {
  padding: var(--space-small) var(--space-container);
  text-align: left;
}

.daily-schedule-table thead th {
  background-color: var(--color-primary);
  color: var(--color-text-white);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.daily-schedule-table tbody tr:nth-child(odd) {
  background-color: var(--color-section-bg, #f6f6f6);
}

.daily-schedule-table td:first-child {
  font-weight: 600;
  color: var(--color-primary);
  width: 120px;
}

/* Visibility */
.tab-panel {
  display: none;
  opacity: 0;
  animation: fadeIn 0.5s ease-out forwards;
}

.tab-panel.active {
  display: block;
  opacity: 1;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Mobile Adjustments */
@media (max-width: 768px) {
  .interactive-tabs-section {
    padding: var(--space-gap) 0;
  }

  .interactive-tabs-grid {
    flex-direction: column;
    gap: var(--space-small);
    padding: 0 var(--space-small);
  }

  .tabs-navigation {
    flex-direction: row;
    width: 100%;
    background-color: var(--color-text-white);
    border-radius: var(--space-small);
    box-shadow: var(--shadow-light);
    overflow-x: auto;
    white-space: nowrap;
    padding: var(--space-small);
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .tabs-navigation::-webkit-scrollbar {
    display: none;
  }

  .tab-button {
    flex-shrink: 0;
    min-width: 120px;
    text-align: center;
    border-bottom: 3px solid transparent;
    margin-right: var(--space-small);
    background-color: transparent;
    padding: var(--space-small);
    font-size: var(--font-body);
  }

  .tab-button.active {
    border-bottom: 3px solid var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-text-white);
    font-weight: 700;
  }

  .tabs-content-wrapper {
    padding: var(--space-small);
  }

  .tab-panel-title {
    font-size: var(--font-heading);
    padding-bottom: var(--space-small);
  }

  .tab-panel-intro {
    font-size: var(--font-body);
    margin-bottom: var(--space-small);
  }

  .daily-schedule-table {
    font-size: var(--font-body);
  }

  .daily-schedule-table th,
  .daily-schedule-table td {
    padding: var(--space-small);
  }
}

</style>

<script is:inline>
  // src/Scripts/scheduleTabs.js

  (function () {
    /**
     * Initializes the schedule tab switching functionality.
     * Safe to run multiple times (Astro View Transitions).
     */
    function initializeScheduleTabs() {
      const tabButtons = document.querySelectorAll(".tab-button");
      const tabPanels = document.querySelectorAll(".tab-panel");

      if (tabButtons.length === 0 || tabPanels.length === 0) return;

      const handleTabClick = (button) => {
        const targetTabId = button.dataset.tab;

        // Reset buttons
        tabButtons.forEach((btn) => btn.classList.remove("active"));

        // Reset panels
        tabPanels.forEach((panel) => {
          panel.classList.remove("active", "fade-in");
          void panel.offsetHeight; // force reflow
        });

        // Activate button
        button.classList.add("active");

        // Activate panel
        const targetPanel = document.getElementById(targetTabId);
        if (targetPanel) {
          targetPanel.classList.add("active", "fade-in");
        }
      };

      const tabListener = (event) => {
        handleTabClick(event.currentTarget);
      };

      tabButtons.forEach((button) => {
        button.removeEventListener("click", tabListener);
        button.addEventListener("click", tabListener);
      });

      // Default activation
      const activeTab = document.querySelector(".tab-button.active");
      if (!activeTab && tabButtons.length > 0) {
        handleTabClick(tabButtons[0]);
      } else if (activeTab) {
        handleTabClick(activeTab);
      }
    }

    // Execution triggers
    document.addEventListener("DOMContentLoaded", initializeScheduleTabs);
    document.addEventListener("astro:page-load", initializeScheduleTabs);
  })();
</script>