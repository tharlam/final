---
// src/components/WhiteHouseSection.astro
---

<section class="house-section white-house-section" data-aos="fade-up">
    <div class="container">
        <div class="house-content-grid">
            <div class="house-image" data-aos="fade-right">
                <img
                    src="/final/ho-2.webp"
                    alt="White House students demonstrating excellence"
                    class="responsive-image"
                    data-i18n-alt="white_house_image_alt"
                    loading="lazy"
                />
            </div>

            <div class="house-text" data-aos="fade-left">
                <p data-i18n="white_house_paragraph_1">
                    The **White House (Sapen House): Spirit of Purity**. The
                    White House, also known as Sapen House, embodies purity,
                    discipline, and precision. Students in White House are known
                    for their meticulous approach to sports, excelling in
                    activities that demand high levels of focus and technical
                    skill. They represent the calm strength and unwavering
                    dedication found in every Tharlam Academy athlete.
                </p>
                <p data-i18n="white_house_paragraph_2">
                    Their focus is on perfecting form and strategy, leading to
                    consistent performance and a deep understanding of their
                    chosen disciplines. White House fosters an environment of
                    quiet determination and refined athleticism.
                </p>
                <div class="house-motto">
                    <strong>Motto:</strong> "Purity, Precision, Dedication."
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* --- Component-Specific Styles --- */
    .white-house-section {
        background-color: #fefefe;
        padding: 70px 0;
    }

    /* CRITICAL DESKTOP FIX: Image on left, Text on right. 
   Since HTML is now (Image, Text), we use row-reverse to display (Text, Image) on desktop,
   which is the intended Image-Left/Text-Right layout when viewing the page content.
   Wait, the **Yellow House** was (Text, Image) in HTML with row-reverse for (Image, Text) view.

   Let's stick to the consistent approach:
   1. HTML written as **(Image, Text)**.
   2. CSS set to **`flex-direction: row`** (the default) to display **(Image, Text)**.
*/
    .white-house-section .house-content-grid {
        flex-direction: row;
    }

    /* --- Essential Structural/General House CSS (Desktop/Base) --- */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0px;
    }
    .house-content-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 60px;
        align-items: center;
        justify-content: center;
    }
    .house-text {
        flex: 1 1 450px;
        min-width: 300px;
        max-width: 1200px;
        text-align: left;
    }
    .house-text p {
        font-size: 16px;
        line-height: 1.7;
        color: #444;
        margin-bottom: 20px;
    }
    .house-text p:first-child {
        font-size: 17px;
        color: #001f3f;
        font-weight: 500;
    }
    .house-image {
        flex: 1 1 350px;
        min-width: 300px;
        max-width: 550px;
        text-align: center;
    }
    .responsive-image {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
    .house-motto {
        font-style: italic;
        font-size: 16px;
        font-weight: 500;
        color: #001f3f;
        margin-top: 25px;
        padding: 10px 15px;
        background-color: rgba(0, 31, 63, 0.05);
        border-left: 4px solid #001f3f;
        border-radius: 4px;
    }

    /* ------------------------------------------------------------------ */
    /* --- MOBILE MEDIA QUERIES (Text on Top / Minimal Gap Fix) --- */
    /* ------------------------------------------------------------------ */

    @media (max-width: 992px) {
        .white-house-section {
            padding: 60px 0;
        }
        .house-content-grid {
            gap: 30px;
            flex-direction: column;
        } /* Forces Text-on-Top on mobile */
    }

    @media (max-width: 768px) {
        .white-house-section {
            padding: 40px 0;
        }
        .container {
            padding: 0 15px;
        }
        .house-content-grid {
            gap: 10px;
            flex-direction: column;
            align-items: center;
        }
        .house-text,
        .house-image {
            width: 100%;
            max-width: 500px;
        }

        /* CRITICAL FIX: Ensure minimal gap below text/above image */
        .house-image {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
        .house-image .responsive-image {
            margin-top: 0 !important;
            display: block;
        }

        .house-text p {
            font-size: 15px;
        }
        .house-text p:first-child {
            font-size: 16px;
        }
    }

    @media (max-width: 480px) {
        .white-house-section {
            padding: 30px 0;
        }
        .container {
            padding: 0 10px;
        }
        .house-content-grid {
            gap: 5px;
        }
        .house-image .responsive-image {
            display: block;
            margin-top: 0 !important;
        }
        .house-text p {
            font-size: 14px;
        }
        .house-text p:first-child {
            font-size: 15px;
        }
        .house-motto {
            font-size: 15px;
        }
    }
</style>
