---
// src/components/Footer.astro
---

<footer class="footer-section">
  <div class="footer-inner-container footer-container">
    
    <div class="footer-col about-col">
      <h3 data-i18n="footer_about_title">About Tharlam</h3>
      <p data-i18n="footer_about_description">
        Blending traditional Buddhist wisdom with modern education to foster 
        compassion, knowledge, and ethical conduct in every student.
      </p>
      <div class="social-icons">
        <a href="https://www.facebook.com/profile.php?id=100057365083022" target="_blank" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
        <a href="/" target="_blank" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
        <a href="https://www.instagram.com/tharlamacademy" target="_blank" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
        <a href="/" target="_blank" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
      </div>
    </div>

    <div class="footer-col">
      <h3 data-i18n="footer_links_title">Quick Links</h3>
      <ul class="footer-list">
        <li><a href="/about" data-i18n="footer_link_about">About Us</a></li>
        <li><a href="/gallery" data-i18n="footer_link_gallery">Tharlam Gallery</a></li>
        <li><a href="/sport" data-i18n="footer_link_sports">Tharlam Sports</a></li>
      </ul>
    </div>

    <div class="footer-col motto-col">
      <h3 data-i18n="footer_motto_title">Our Motto</h3>
      <div class="motto-content">
        <p class="motto-text" data-i18n="footer_motto_content">
          "Wisdom through Compassion, <br /> Enlightenment through Education."
        </p>
      </div>
    </div>

    <div class="footer-col newsletter-col">
      <h3 data-i18n="footer_newsletter_title">Newsletter</h3>
      <p data-i18n="footer_newsletter_desc">Stay updated with our latest news.</p>
      <form class="newsletter-form" action="https://formspree.io/f/mgvkpwbd" method="POST">
        <input type="email" name="email" required placeholder="Email Address" />
        <button type="submit" data-i18n="footer_subscribe">Subscribe</button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-inner-container bottom-content">
      <p>© 2024 Tharlam Academy. All Rights Reserved.</p>
      <div class="policy-links">
        <a href="/">Privacy Policy</a>
        <span class="separator">|</span>
        <a href="/">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<button id="backToTop" class="back-to-top" aria-label="Back to top">
  <i class="fas fa-chevron-up"></i>
</button>

<style>
  .footer-section {
    background-color: var(--nav-primary-darker);
    color: var(--nav-text-white);
    padding: 60px 0 0;
    width: 100%;
    /* Removed border-top line/underline */
  }

  .footer-inner-container {
    max-width: 1200px; /* Standard container width */
    margin: 0 auto;
    padding: 0 20px;
  }

  .footer-container {
    display: flex;
    justify-content: space-between;
    gap: 40px; 
    padding-bottom: 60px;
  }

  .footer-col { flex: 1; }
  .about-col { flex: 1.2; }

  .footer-section h3 {
    color: var(--nav-text-white);
    font-size: var(--nav-heading);
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    /* Removed the ::after underline decoration */
  }

  .footer-section p {
    font-size: var(--nav-body); 
    line-height: var(--nav-height-text);
    color: rgba(255, 255, 255, 0.7);
  }

  .motto-content {
    border-left: 3px solid var(--nav-accent-green);
    padding-left: 15px;
    margin-top: 10px;
  }

  .motto-text {
    font-style: italic;
    font-weight: 500;
    color: var(--nav-text-white);
    line-height: var(--nav-height-text);
    margin: 0;
  }

  .footer-list { list-style: none; padding: 0; }
  .footer-list li { margin-bottom: 12px; }
  
  .footer-list a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none; /* Removed underline */
    font-size: var(--nav-body);
    transition: 0.3s ease;
  }

  .footer-list a:hover {
    color: var(--nav-accent-green);
    text-decoration: none; /* Ensure no underline on hover */
  }

  .social-icons { display: flex; gap: 12px; margin-top: 20px; }
  .social-icons a { 
    color: var(--nav-text-white); 
    text-decoration: none; /* Removed underline from icons */
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: rgba(255,255,255,0.05);
    border-radius: 50%;
    transition: 0.3s;
  }
  .social-icons a:hover { 
    background-color: var(--nav-accent-green);
    transform: translateY(-3px); 
  }

  .newsletter-form input {
    width: 100%; 
    padding: 12px; 
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1); 
    color: var(--nav-text-white); 
    border-radius: 4px; 
    margin-bottom: 10px; 
    font-size: var(--nav-size-base); 
    outline: none;
  }

  .newsletter-form button {
    width: 100%; 
    padding: 12px; 
    background: var(--nav-accent-green); 
    color: var(--nav-text-white);
    border: none; 
    border-radius: 4px; 
    font-weight: 600; 
    cursor: pointer; 
    transition: 0.3s;
    font-size: var(--nav-size-base);
  }

  .newsletter-form button:hover { background: var(--nav-green-hover); }

  .footer-bottom {
    background-color: rgba(0, 0, 0, 0.2);
    padding: 20px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .bottom-content {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }
  
  .policy-links .separator { margin: 0 10px; }
  .policy-links a { 
    color: inherit; 
    text-decoration: none; /* Removed underline */
  }
  .policy-links a:hover { 
    color: var(--nav-text-white);
    text-decoration: none;
  }

  .back-to-top {
    position: fixed;
    bottom: 25px;
    right: 25px;
    width: 40px;
    height: 40px;
    background-color: var(--nav-accent-green);
    color: var(--nav-text-white);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0; visibility: hidden; z-index: 1000;
    transition: 0.4s ease;
  }

  .back-to-top.show { opacity: 1; visibility: visible; }

  @media (max-width: 768px) {
    .footer-container { flex-direction: column; text-align: center; gap: 40px; }
    .social-icons { justify-content: center; }
    .motto-content { border-left: none; border-top: 2px solid var(--nav-accent-green); padding-left: 0; padding-top: 10px; }
    .bottom-content { flex-direction: column; gap: 10px; text-align: center; }
  }
</style>

<script is:inline>
  function initializeFooter() {
    const backToTopBtn = document.getElementById("backToTop");
    const handleScroll = () => {
      if (window.scrollY > 400) {
        backToTopBtn?.classList.add("show");
      } else {
        backToTopBtn?.classList.remove("show");
      }
    };
    window.addEventListener("scroll", handleScroll);
    backToTopBtn?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
  document.addEventListener("DOMContentLoaded", initializeFooter);
  document.addEventListener("astro:page-load", initializeFooter);
</script>