---
// src/components/Footer.astro
---

<footer class="footer-section">
  <div class="container footer-container">
    
    <div class="footer-col about-col">
      <h3 data-i18n="footer_about_title">About Tharlam</h3>
      <p data-i18n="footer_about_description">
        Blending traditional Buddhist wisdom with modern education to foster 
        compassion, knowledge, and ethical conduct in every student.
      </p>
      <div class="social-icons">
        <a href="https://www.facebook.com/profile.php?id=100057365083022" target="_blank" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
        <a href="/" target="_blank" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
        <a href="https://www.instagram.com/tharlamacademy" target="_blank" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
        <a href="/" target="_blank" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
      </div>
    </div>

    <div class="footer-col">
      <h3 data-i18n="footer_links_title">Quick Links</h3>
      <ul class="footer-list">
        <li><a href="/about" data-i18n="footer_link_about">About Us</a></li>
        <li><a href="/gallery" data-i18n="footer_link_gallery">Tharlam Gallery</a></li>
        <li><a href="/sport" data-i18n="footer_link_sports">Tharlam Sports</a></li>
      </ul>
    </div>

    <div class="footer-col motto-col">
      <h3 data-i18n="footer_motto_title">Our Motto</h3>
      <div class="motto-content">
        <p class="motto-text" data-i18n="footer_motto_content">
          "Wisdom through Compassion, <br /> Enlightenment through Education."
        </p>
      </div>
    </div>

    <div class="footer-col newsletter-col">
      <h3 data-i18n="footer_newsletter_title">Newsletter</h3>
      <p data-i18n="footer_newsletter_desc">Stay updated with our latest news.</p>
      <form class="newsletter-form" action="https://formspree.io/f/mgvkpwbd" method="POST">
        <input type="email" name="email" required placeholder="Email Address" />
        <button type="submit" data-i18n="footer_subscribe">Subscribe</button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container bottom-content">
      <p>© 2024 Tharlam Academy. All Rights Reserved.</p>
      <div class="policy-links">
        <a href="/">Privacy Policy</a>
        <span class="separator">|</span>
        <a href="/">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<button id="backToTop" class="back-to-top" aria-label="Back to top">
  <i class="fas fa-chevron-up"></i>
</button>

<style>
  .footer-section {
    background-color: var(--color-primary-darker);
    color: var(--color-text-white);
    padding: 80px 0 0;
    border-top: 1px solid var(--border-light-blue);
    width: 100%;
  }

  /* Sync with WhiteHouseSection container logic */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0; 
  }

  .footer-container {
    display: flex;
    justify-content: space-between;
    gap: 60px; 
    padding-bottom: 60px;
  }

  .footer-col { flex: 1; }
  .about-col { flex: 1.2; }

  /* Heading Style - White */
  .footer-section h3 {
    color: var(--color-text-white);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 25px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    position: relative;
  }

  /* Green Accent line under headings */
  .footer-section h3::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 30px;
    height: 2px;
    background-color: var(--color-accent-green);
  }

  .footer-section p {
    font-size: 16px; 
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
  }

  .motto-text {
    font-style: italic;
    font-weight: 500;
    color: var(--color-text-white);
    line-height: 1.6;
    margin: 0;
  }

  .footer-list { list-style: none; padding: 0; }
  .footer-list li { margin-bottom: 12px; }
  .footer-list a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: 0.3s ease;
  }
  .footer-list a:hover {
    color: var(--color-accent-green);
    padding-left: 8px;
  }

  .social-icons { display: flex; gap: 15px; margin-top: 20px; }
  .social-icons a { color: white; font-size: 1.2rem; transition: 0.3s; opacity: 0.8; }
  .social-icons a:hover { color: var(--color-accent-green); transform: translateY(-3px); opacity: 1; }

  .newsletter-form input {
    width: 100%; padding: 12px; background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-light-blue); color: white; border-radius: 4px; margin-bottom: 10px; outline: none;
  }
  .newsletter-form button {
    width: 100%; padding: 12px; background: var(--color-accent-green); color: white;
    border: none; border-radius: 4px; font-weight: 600; cursor: pointer; transition: 0.3s;
  }
  .newsletter-form button:hover { background: var(--color-green-hover); }

  .footer-bottom {
    background-color: rgba(0, 0, 0, 0.3);
    padding: 25px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .bottom-content {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }

  /* --- REFINED SMALL BACK TO TOP BUTTON --- */
  .back-to-top {
    position: fixed;
    bottom: 25px; /* Slightly closer to edge */
    right: 25px;
    width: 38px;  /* Reduced from 45px */
    height: 38px; /* Reduced from 45px */
    background-color: var(--color-accent-green);
    color: var(--color-text-white);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem; /* Smaller arrow icon */
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
    opacity: 0;           
    visibility: hidden;    
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); /* Added a nice bounce */
    z-index: 1000;
  }

  .back-to-top.show {
    opacity: 1;
    visibility: visible;
    bottom: 30px; /* Positions perfectly when showing */
  }

  .back-to-top:hover {
    background-color: var(--color-green-hover);
    transform: translateY(-3px);
  }

  /* --- VERY SMALL FOR MOBILE --- */
  @media (max-width: 480px) {
    .back-to-top {
      width: 32px;  /* Very compact for mobile */
      height: 32px;
      bottom: 15px;
      right: 15px;
      font-size: 0.8rem;
    }
    
    .back-to-top.show {
      bottom: 20px;
    }
  }

  /* Responsive Behavior */
  @media (max-width: 992px) {
    .container { padding: 0 15px; }
    .footer-container { gap: 30px; }
  }

  @media (max-width: 768px) {
    .footer-container { flex-direction: column; text-align: center; gap: 40px; }
    .footer-section h3::after { left: 50%; transform: translateX(-50%); }
    .social-icons { justify-content: center; }
    .bottom-content { flex-direction: column; gap: 10px; }
  }
</style>

<script>
  // Select the button
  const backToTopBtn = document.getElementById("backToTop");

  // Show/Hide logic
  window.addEventListener("scroll", () => {
    if (window.scrollY > 400) {
      backToTopBtn?.classList.add("show");
    } else {
      backToTopBtn?.classList.remove("show");
    }
  });

  // Scroll to top logic
  backToTopBtn?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  });
</script>