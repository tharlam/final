---
// src/components/FAQSection.astro
const faqItems = [
  { 
    question: "What is the purpose of Tharlam Academy?", 
    answer: "Tharlam Academy provides a holistic education for monks by integrating traditional Sakya Buddhist teachings with modern academic subjects like science, mathematics, languages, social studies, health science, and more. Its mission is to preserve the Sakya tradition while equipping monks for contemporary life."
  },
  { 
    question: "Who studies at Tharlam Academy?", 
    answer: "The academy is designed primarily for ordained monks from Tharlam Monastery. While lay practitioners may attend public teachings, formal academic enrollment is exclusively reserved for monks only."
  },
  { 
    question: "What grades are offered?", 
    answer: "Tharlam Academy provides education up to grade 10, with the option to continue through class 11 and 12 for those monks who wish to pursue higher secondary education, supporting their path toward national exams."
  },
  { 
    question: "Example Question 4: How can I donate?",
    answer: "You can find donation options and details on our 'Support Us' page, which includes information on specific projects or general fund contributions."
  },
  { 
    question: "Example Question 5: Where is the Academy located?",
    answer: "Tharlam Academy is located in Kathmandu, Nepal, operating as a part of the Tharlam Monastery complex."
  }
];
---

<section class="faq-section">
  <div class="container">
    <div class="header-content">
      <h2 class="faq-title" data-aos="fade-right">
        Frequently Asked <span class="highlight">Questions</span>
      </h2>
      <p class="faq-subtitle" data-aos="fade-right" data-aos-delay="50">
        Find quick answers to common Tharlam questions.
      </p>
    </div>

    <div class="faq-items-wrapper" data-aos="fade-left" data-aos-delay="100">
      <div class="faq-list">
        {faqItems.map((item, index) => (
          <div class={`faq-item ${index === 0 ? 'open' : ''}`}>
            <button class="faq-question-button" aria-expanded={index === 0 ? 'true' : 'false'}>
              <span class="question-text">{item.question}</span>
              <span class="toggle-icon">{index === 0 ? '−' : '+'}</span>
            </button>
            <div class="faq-answer">
              <div class="answer-label">Answer</div>
              <p>{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
/* --- SECTION --- */
.faq-section {
  padding: var(--space-section) 0;
  background-color: #f7f7f7; /* keep original background */
}
.container {
  width: var(--container-width);
  max-width: var(--max-container);
  margin: 0 auto;
  padding: 0 var(--space-container);
  display: flex;
  gap: var(--space-gap);
  align-items: flex-start;
}

/* --- HEADER --- */
.header-content {
  flex: 1 1 35%; 
  min-width: 300px;
}
.faq-items-wrapper {
  flex: 1 1 65%;
  max-width: 800px;
}
.faq-title {
  font-size: var(--font-heading);
  font-family: inherit;
  font-weight: 700;
  line-height: 1.2;
  color: #1a2a47; /* keep original color */
  margin-bottom: var(--space-small);
}
.faq-title .highlight {
  color: #1e87f0;
  display: block;
}
.faq-subtitle {
  font-size: var(--font-body);
  font-family: inherit;
  color: #666;
  margin-bottom: var(--space-gap);
}

/* --- FAQ LIST --- */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-small);
}
.faq-item {
  background-color: #fff;
  border: 1px solid #eee;
  border-radius: var(--space-small);
  overflow: hidden;
  transition: all 0.3s ease;
  box-shadow: var(--shadow-light);
}
.faq-item.open {
  border-color: #1e87f0;
  box-shadow: var(--shadow-medium);
}
.faq-question-button {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: var(--space-small) var(--space-gap);
  border: none;
  background: none;
  text-align: left;
  cursor: pointer;
  font-size: var(--font-body);
  font-family: inherit;
  font-weight: 500;
  color: #333;
  transition: color 0.3s, background-color 0.3s;
}
.faq-question-button:hover {
  color: #1a2a47;
  background-color: #fcfcfc;
}
.question-text {
  flex-grow: 1;
  line-height: var(--line-height-text);
}
.toggle-icon {
  font-size: var(--font-body);
  font-family: inherit;
  color: #333;
  transition: color 0.3s;
}
.faq-item.open .toggle-icon {
  color: #1e87f0;
}

/* --- ANSWER --- */
.faq-answer {
  padding: 0 var(--space-gap);
  border-top: 1px solid #eee;
  background-color: #fcfcfc;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-in-out, padding 0.3s ease-in-out;
}
.faq-item.open .faq-answer {
  max-height: 500px;
  padding: var(--space-small) var(--space-gap) var(--space-gap);
}
.answer-label {
  font-size: var(--space-small);
  font-family: inherit;
  font-weight: 700;
  color: #1e87f0;
  text-transform: uppercase;
  margin-bottom: var(--space-small);
}
.faq-answer p {
  font-size: var(--font-body);
  font-family: inherit;
  line-height: var(--line-height-text);
  color: #555;
  margin: 0;
}

/* --- SINGLE BREAKPOINT --- */
@media (max-width: 768px) {
  .container {
    flex-direction: column;
    gap: var(--space-gap);
  }
  .header-content,
  .faq-items-wrapper {
    max-width: 100%;
    flex: unset;
  }
}
</style>

<script is:inline>
function initializeFAQAccordion() {
  const faqSection = document.querySelector('.faq-section');
  if (!faqSection) return;

  const faqQuestions = faqSection.querySelectorAll('.faq-question-button');

  const toggleAccordion = (question) => {
    const faqItem = question.closest('.faq-item');
    const icon = faqItem.querySelector('.toggle-icon');
    const isActive = faqItem.classList.contains('open');

    // Close others
    faqSection.querySelectorAll('.faq-item.open').forEach(otherItem => {
      if (otherItem !== faqItem) {
        otherItem.classList.remove('open');
        otherItem.querySelector('.faq-question-button').setAttribute('aria-expanded', 'false');
        otherItem.querySelector('.toggle-icon').textContent = '+';
      }
    });

    // Toggle current
    if (isActive) {
      faqItem.classList.remove('open');
      question.setAttribute('aria-expanded', 'false');
      icon.textContent = '+';
    } else {
      faqItem.classList.add('open');
      question.setAttribute('aria-expanded', 'true');
      icon.textContent = '−';
    }
  };

  faqQuestions.forEach(question => {
    if (question.hasAttribute('data-accordion-initialized')) return;
    question.setAttribute('data-accordion-initialized', 'true');

    if (question.closest('.faq-item').classList.contains('open')) {
      question.setAttribute('aria-expanded', 'true');
      question.querySelector('.toggle-icon').textContent = '−';
    }

    question.addEventListener('click', e => {
      e.preventDefault();
      toggleAccordion(question);
    });

    question.addEventListener('keydown', e => {
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        toggleAccordion(question);
      }
    });
  });
}

document.addEventListener('DOMContentLoaded', initializeFAQAccordion);
document.addEventListener('astro:page-load', initializeFAQAccordion);
</script>
