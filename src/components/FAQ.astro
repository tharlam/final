---
// src/components/FAQSection.astro
// FINAL VERSION: Cleaned up version with no images, no search bar, and using the PLUS/MINUS sign toggle logic.

// Define the static FAQ content
const faqItems = [
    { 
        question: "What is the purpose of Tharlam Academy?", 
        answer: "Tharlam Academy provides a holistic education for monks by integrating traditional Sakya Buddhist teachings with modern academic subjects like science, mathematics, languages, social studies, health science, and more. Its mission is to preserve the Sakya tradition while equipping monks for contemporary life."
    },
    { 
        question: "Who studies at Tharlam Academy?", 
        answer: "The academy is designed primarily for ordained monks from Tharlam Monastery. While lay practitioners may attend public teachings, formal academic enrollment is exclusively reserved for monks only."
    },
    { 
        question: "What grades are offered?", 
        answer: "Tharlam Academy provides education up to grade 10, with the option to continue through class 11 and 12 for those monks who wish to pursue higher secondary education, supporting their path toward national exams."
    },
    { 
        question: "Example Question 4: How can I donate?",
        answer: "You can find donation options and details on our 'Support Us' page, which includes information on specific projects or general fund contributions."
    },
    { 
        question: "Example Question 5: Where is the Academy located?",
        answer: "Tharlam Academy is located in Kathmandu, Nepal, operating as a part of the Tharlam Monastery complex."
    }
];
---

<section class="faq-section">
    <div class="container">
        
        <div class="header-content">
            <h2 class="faq-title" data-aos="fade-right">
                Frequently Asked 
                <span class="highlight">Highlight</span> 
                Questions
            </h2>
            <p class="faq-subtitle" data-aos="fade-right" data-aos-delay="50">
                Find quick answers to common Tharlam questions.
            </p>
        </div>

        <div class="faq-items-wrapper" data-aos="fade-left" data-aos-delay="100">
            
            <div class="faq-list">
                
                {faqItems.map((item, index) => (
                    <div class={`faq-item ${index === 0 ? 'open' : ''}`}>
                        <button class="faq-question-button" aria-expanded={index === 0 ? 'true' : 'false'}>
                            <span class="question-text">{item.question}</span>
                            <span class="button-icons">
                                <span class={`toggle-icon fas ${index === 0 ? 'fa-minus' : 'fa-plus'}`}></span>
                            </span>
                        </button>
                        <div class="faq-answer">
                            <div class="answer-label">Answer</div>
                            <p>{item.answer}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
/* --- General/Structural Styles --- */
.faq-section {
    padding: 80px 0;
    background-color: #f7f7f7;
}
.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    gap: 60px;
    align-items: flex-start;
}

/* Column Widths */
.header-content {
    flex: 1 1 35%; 
    max-width: 400px;
    min-width: 300px;
    padding-top: 15px; 
}
.faq-items-wrapper {
    flex: 1 1 65%;
    max-width: 800px;
}

/* --- Typography and Header Styling --- */
.faq-title {
    font-size: 38px;
    font-weight: 700;
    line-height: 1.2;
    color: #1a2a47;
    margin-bottom: 10px;
}
.faq-title .highlight {
    color: #1e87f0;
    display: block;
}
.faq-subtitle {
    font-size: 16px;
    color: #666;
    margin-bottom: 40px;
}

/* --- FAQ Item Styling (Functional) --- */
.faq-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
}
.faq-item {
    background-color: #fff;
    border: 1px solid #eee;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: 0 2px 5px rgba(0,0,0,0.03);
}
.faq-item.open {
    border-color: #1e87f0;
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
}
.faq-question-button {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 15px 20px;
    border: none;
    background: none;
    text-align: left;
    cursor: pointer;
    font-size: 16px;
    font-weight: 500;
    color: #333;
    transition: color 0.3s, background-color 0.3s;
}
.faq-question-button:hover {
    color: #1a2a47;
    background-color: #fcfcfc;
}
.question-text {
    flex-grow: 1;
    line-height: 1.4;
}
.button-icons {
    display: flex;
    align-items: center;
    margin-left: 15px;
}

/* Toggle Icon Styling (+ and -) */
.toggle-icon {
    font-size: 20px;
    line-height: 1;
    width: 20px; /* Ensures consistent alignment */
    text-align: right;
    color: #333;
    transition: color 0.3s;
}

/* When open, the icon color changes */
.faq-item.open .toggle-icon {
    color: #1e87f0;
}


/* Answer Styling (Controlled by JS) */
.faq-answer {
    padding: 0 20px;
    border-top: 1px solid #eee;
    background-color: #fcfcfc;
    /* Initial state for collapse animation */
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-in-out, padding 0.3s ease-in-out;
}
.faq-item.open .faq-answer {
    max-height: 500px; /* Large value for smooth content reveal */
    padding: 15px 20px 20px;
}
.faq-answer .answer-label {
    font-size: 12px;
    font-weight: 700;
    color: #1e87f0;
    text-transform: uppercase;
    margin-bottom: 5px;
}
.faq-answer p {
    font-size: 15px;
    line-height: 1.6;
    color: #555;
    margin: 0;
}


/* --- MOBILE OPTIMIZATION --- */
@media (max-width: 992px) {
    .container {
        flex-direction: column;
        gap: 30px;
    }
    .header-content,
    .faq-items-wrapper {
        max-width: 100%;
        flex: unset;
    }
    .header-content {
        padding-top: 0;
    }
    .faq-title {
        font-size: 32px;
    }
}

@media (max-width: 768px) {
    .faq-section {
        padding: 50px 0;
    }
    .faq-title {
        font-size: 28px;
    }
}
@media (max-width: 480px) {
    .container {
        padding: 0 15px;
    }
    .faq-question-button {
        padding: 12px 15px;
        font-size: 15px;
    }
    .faq-answer {
        padding: 0 15px;
    }
    .faq-item.open .faq-answer {
        padding: 12px 15px 15px;
    }
}
</style>

<script is:inline>
    /**
     * Initializes the FAQ Accordion functionality.
     * Toggles between the plus (+) and minus (-) icons.
     */
    function initializeFAQAccordion() {
        const faqQuestions = document.querySelectorAll('.faq-question-button');

        if (faqQuestions.length === 0) {
            return;
        }

        const toggleAccordion = (question) => {
            const faqItem = question.closest('.faq-item');
            const answer = faqItem.querySelector('.faq-answer');
            const icon = faqItem.querySelector('.toggle-icon');
            const isActive = faqItem.classList.contains('open');

            // 1. Close all other open items
            document.querySelectorAll('.faq-item.open').forEach(otherItem => {
                if (otherItem !== faqItem) {
                    otherItem.classList.remove('open');
                    otherItem.querySelector('.faq-answer').style.maxHeight = null;
                    otherItem.querySelector('.faq-question-button').setAttribute('aria-expanded', 'false');
                    // Reset other icons to plus
                    otherItem.querySelector('.toggle-icon').classList.remove('fa-minus');
                    otherItem.querySelector('.toggle-icon').classList.add('fa-plus');
                }
            });

            // 2. Toggle the clicked item
            if (isActive) {
                // Collapse
                faqItem.classList.remove('open');
                answer.style.maxHeight = null;
                question.setAttribute('aria-expanded', 'false');
                // Change icon to plus
                icon.classList.remove('fa-minus');
                icon.classList.add('fa-plus');
            } else {
                // Expand
                faqItem.classList.add('open');
                question.setAttribute('aria-expanded', 'true');
                // Change icon to minus
                icon.classList.remove('fa-plus');
                icon.classList.add('fa-minus');
                
                // Set max-height after adding the 'open' class for smooth transition
                setTimeout(() => {
                    answer.style.maxHeight = answer.scrollHeight + 50 + "px"; // Add buffer for padding
                }, 0);
            }
        };

        faqQuestions.forEach(question => {
            if (question.hasAttribute('data-accordion-initialized')) return;
            question.setAttribute('data-accordion-initialized', 'true');

            // Initial setup for the first item if it has the 'open' class
            if (question.closest('.faq-item').classList.contains('open')) {
                const answer = question.closest('.faq-item').querySelector('.faq-answer');
                 setTimeout(() => {
                    answer.style.maxHeight = answer.scrollHeight + 50 + "px";
                }, 0);
            }
            
            question.addEventListener('click', (e) => {
                e.preventDefault();
                toggleAccordion(question);
            });

            question.addEventListener('keydown', (e) => {
                if (e.key === ' ' || e.key === 'Enter') {
                    e.preventDefault();
                    toggleAccordion(question);
                }
            });
        });
    }

    // --- EXECUTION TRIGGERS ---
    document.addEventListener('DOMContentLoaded', initializeFAQAccordion);
    document.addEventListener('astro:page-load', initializeFAQAccordion);
</script>