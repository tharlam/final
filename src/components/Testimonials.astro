---
// Import BASE_PATH for robust asset linking in Astro
const BASE_PATH = import.meta.env.BASE_URL;
---

<section id="testo" class="testimonials-section">
  <div class="testimonials-header" data-aos="fade-up">
    <h2 class="testimonials-title" data-i18n="testo_title"></h2>
    <p class="testimonials-subtitle" data-i18n="testo_subtitle"></p>

    <div class="testimonials-navigation">
      <button class="testo-prev-btn disabled" aria-label="Previous testimonials">
        <i class="fas fa-chevron-left"></i>
      </button>
      <button class="testo-next-btn" aria-label="Next testimonials">
        <i class="fas fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <div class="testo-slider-wrapper">
    <div class="testimonials-container">
      
      <div class="testimonial-card" data-aos="fade-up">
        <i class="fas fa-quote-left quote-icon"></i>
        <p class="testimonial-text" data-i18n="testo1_p1"></p>
        <div class="testimonial-author">
          <img src={`${BASE_PATH}private-assets/testo3.webp`} data-i18n-alt="testo1_img_alt" />
          <div class="author-info">
            <p class="author-name" data-i18n="testo1_name"></p>
            <p class="author-role" data-i18n="testo1_role"></p>
          </div>
        </div>
      </div>

      <div class="testimonial-card" data-aos="fade-up" data-aos-delay="100">
        <i class="fas fa-quote-left quote-icon"></i>
        <p class="testimonial-text" data-i18n="testo2_p1"></p>
        <div class="testimonial-author">
          <img src={`${BASE_PATH}private-assets/testo1.webp`} data-i18n-alt="testo2_img_alt" />
          <div class="author-info">
            <p class="author-name" data-i18n="testo2_name"></p>
            <p class="author-role" data-i18n="testo2_role"></p>
          </div>
        </div>
      </div>

      <div class="testimonial-card" data-aos="fade-up" data-aos-delay="200">
        <i class="fas fa-quote-left quote-icon"></i>
        <p class="testimonial-text" data-i18n="testo3_p1"></p>
        <div class="testimonial-author">
          <img src={`${BASE_PATH}private-assets/testo2.webp`} data-i18n-alt="testo3_img_alt" />
          <div class="author-info">
            <p class="author-name" data-i18n="testo3_name"></p>
            <p class="author-role" data-i18n="testo3_role"></p>
          </div>
        </div>
      </div>

      <div class="testimonial-card" data-aos="fade-up" data-aos-delay="300">
        <i class="fas fa-quote-left quote-icon"></i>
        <p class="testimonial-text" data-i18n="testo4_p1"></p>
        <div class="testimonial-author">
          <img src={`${BASE_PATH}gallery/testo4.webp`} data-i18n-alt="testo4_img_alt" />
          <div class="author-info">
            <p class="author-name" data-i18n="testo4_name"></p>
            <p class="author-role" data-i18n="testo4_role"></p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* --- Section Foundation --- */
  .testimonials-section {
    padding: var(--space-section) 0;
    background-color: transparent;
    color: var(--color-text);
    overflow: hidden;
  }

  .testimonials-header {
    width: var(--container-width);
    max-width: var(--max-container);
    margin: 0 auto var(--space-gap) auto;
    padding: 0 var(--space-container);
    position: relative;
    text-align: center;
  }

  .testimonials-title {
    font-size: var(--font-heading);
    color: var(--color-heading);
    font-weight: 700;
    margin-bottom: var(--space-small);
  }

  .testimonials-subtitle {
    font-size: var(--font-body);
    opacity: 0.8;
  }

  /* --- Navigation Buttons --- */
  .testimonials-navigation {
    display: none; /* Only visible on desktop */
    position: absolute;
    right: var(--space-container);
    bottom: 0;
    gap: 10px;
  }

  .testo-prev-btn, .testo-next-btn {
    background: var(--color-primary);
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: var(--space-small);
    cursor: pointer;
    transition: 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .testo-prev-btn.disabled, .testo-next-btn.disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* --- Slider Engine --- */
  .testo-slider-wrapper {
    width: var(--container-width);
    max-width: var(--max-container);
    margin: 0 auto;
    overflow: hidden;
    padding: 20px 0; /* Space for shadows */
  }

  .testimonials-container {
    display: flex;
    gap: var(--space-gap);
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* --- The Card --- */
  .testimonial-card {
    background: white;
    padding: var(--space-gap);
    border-radius: var(--space-small);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    flex: 0 0 calc(33.333% - (var(--space-gap) * 2 / 3)); /* 3 Columns */
    min-width: 280px;
    display: flex;
    flex-direction: column;
    border-top: 4px solid var(--color-primary);
  }

  .quote-icon {
    font-size: 2rem;
    color: var(--color-primary);
    opacity: 0.2;
    margin-bottom: var(--space-small);
  }

  .testimonial-text {
    font-size: var(--font-body);
    line-height: 1.6;
    flex-grow: 1;
    margin-bottom: var(--space-gap);
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: var(--space-small);
  }

  .testimonial-author img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-primary);
  }

  .author-name {
    font-size: var(--font-body);
    font-weight: 700;
    color: var(--color-heading);
    margin: 0;
  }

  .author-role {
    font-size: 0.8rem;
    opacity: 0.7;
    margin: 0;
  }

  /* --- Responsive Logic --- */
  @media (min-width: 992px) {
    .testimonials-navigation { display: flex; }
  }

  @media (max-width: 991px) {
    .testimonial-card {
      flex: 0 0 calc(50% - (var(--space-gap) / 2)); /* 2 Columns */
    }
    .testo-slider-wrapper { overflow: visible; }
    .testimonials-container { 
      flex-wrap: nowrap; 
      overflow-x: auto; 
      padding-bottom: 20px;
      -webkit-overflow-scrolling: touch;
    }
  }

  @media (max-width: 600px) {
    .testimonial-card {
      flex: 0 0 100%; /* 1 Column */
    }
  }
</style>

<script is:inline>
  function initTestoSlider() {
    const container = document.querySelector('.testimonials-container');
    const cards = document.querySelectorAll('.testimonial-card');
    const nextBtn = document.querySelector('.testo-next-btn');
    const prevBtn = document.querySelector('.testo-prev-btn');
    
    if (!container || cards.length === 0 || !nextBtn) return;

    let currentIndex = 0;

    function getVisibleCards() {
      if (window.innerWidth < 600) return 1;
      if (window.innerWidth < 992) return 2;
      return 3;
    }

    function updateSlider() {
      const visibleCards = getVisibleCards();
      const maxIndex = cards.length - visibleCards;
      
      // Ensure index stays in bounds
      if (currentIndex > maxIndex) currentIndex = maxIndex;
      if (currentIndex < 0) currentIndex = 0;

      const gap = parseInt(getComputedStyle(container).gap) || 0;
      const cardWidth = cards[0].offsetWidth;
      const moveDistance = currentIndex * (cardWidth + gap);

      container.style.transform = `translateX(-${moveDistance}px)`;

      // Update Buttons
      prevBtn.classList.toggle('disabled', currentIndex === 0);
      nextBtn.classList.toggle('disabled', currentIndex >= maxIndex);
    }

    nextBtn.addEventListener('click', () => {
      const maxIndex = cards.length - getVisibleCards();
      if (currentIndex < maxIndex) {
        currentIndex++;
        updateSlider();
      }
    });

    prevBtn.addEventListener('click', () => {
      if (currentIndex > 0) {
        currentIndex--;
        updateSlider();
      }
    });

    window.addEventListener('resize', updateSlider);
    updateSlider();
  }

  // Initialize on load
  document.addEventListener('DOMContentLoaded', initTestoSlider);
  document.addEventListener('astro:page-load', initTestoSlider);
</script>