---
// Import BASE_PATH for robust asset linking in Astro
const BASE_PATH = import.meta.env.BASE_URL;
---

<section id="testo" class="testimonials-section">
  <div class="testimonials-header" data-aos="fade-up">
    <h2 class="testimonials-title" data-i18n="testimonials_section_title">
      Testimonials
    </h2>
    <p class="testimonials-subtitle" data-i18n="testimonials_section_subtitle">
      Hear directly from our students and faculty.
    </p>

    <div class="testimonials-navigation">
      <button class="testo-prev-btn" aria-label="Previous testimonials">
        <i class="fas fa-chevron-left"></i>
      </button>
      <button class="testo-next-btn" aria-label="Next testimonials">
        <i class="fas fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <div class="testo-slider-wrapper">
    <div class="testimonials-container">
      <div class="testimonial-card" data-aos="fade-left" data-aos-delay="100">
        <i class="fas fa-quote-left quote-icon"></i>
        <p class="testimonial-text" data-i18n="testimonial_lobsang_text">
          “Before joining Tharlam Academy, I could not read. Now I can recite
          prayers, study texts, and help others.”
        </p>
        <div class="testimonial-author">
          <img
            src={`${BASE_PATH}testo3.webp`}
            alt="Photo of Lobsang Nyima, student"
            data-i18n-alt="testimonial_lobsang_alt"
          />
          <div class="author-info">
            <p class="author-name" data-i18n="testimonial_lobsang_name">
              Lobsang Nyima
            </p>
            <p class="author-role" data-i18n="testimonial_lobsang_role">
              Age 12 (Class 4)
            </p>
          </div>
        </div>
      </div>

      <div class="testimonial-card" data-aos="fade-up" data-aos-delay="200">
        <i class="fas fa-quote-left quote-icon"></i>
        <p class="testimonial-text" data-i18n="testimonial_pema_text">
          "Hello! My name is Chokey Wangpo. I feel very happy to study at
          Tharlam Academy. The teachers are kind, and I have many good friends
          here. I love learning about the Buddha’s teachings and also enjoy
          reading English books. We play, we learn, and we help each other like
          a big family. Tharlam Academy is my second home!"
        </p>
        <div class="testimonial-author">
          <img
            src={`${BASE_PATH}testo1.webp`}
            alt="Photo of Pema Sherap, student"
            data-i18n-alt="testimonial_pema_alt"
          />
          <div class="author-info">
            <p class="author-name" data-i18n="testimonial_pema_name">
              Chokey Wangpo
            </p>
            <p class="author-role" data-i18n="testimonial_pema_role">
              Age 14 (Class 6)
            </p>
          </div>
        </div>
      </div>

      <div class="testimonial-card" data-aos="fade-right" data-aos-delay="300">
        <i class="fas fa-quote-left quote-icon"></i>
        <p class="testimonial-text" data-i18n="testimonial_dhundup_text">
          "Hi! I’m Dhundup Lama. I came to Tharlam Academy when I was small.
          Since then, I’ve learned many things — from meditation to math. The
          classes are fun, and our teachers guide us with love. I feel proud to
          be part of this academy. One day, I want to help others just like I’ve
          been helped here."
        </p>
        <div class="testimonial-author">
          <img
            src={`${BASE_PATH}testo2.webp`}
            alt="Photo of Dhundup, student"
            data-i18n-alt="testimonial_dhundup_alt"
          />
          <div class="author-info">
            <p class="author-name" data-i18n="testimonial_dhundup_name">
              Dhundup
            </p>
            <p class="author-role" data-i18n="testimonial_dhundup_role">
              Age 12 (Class 4)
            </p>
          </div>
        </div>
      </div>

      <div class="testimonial-card" data-aos="fade-left" data-aos-delay="400">
        <i class="fas fa-quote-left quote-icon"></i>
        <p class="testimonial-text" data-i18n="testimonial_gyen_text">
          “We’re grateful to all the sponsors who help us learn not only facts
          but how to be good human beings.”
        </p>
        <div class="testimonial-author">
          <img
            src={`${BASE_PATH}testo4.webp`}
            alt="Photo of Gyen Lekshay, Senior Teacher"
            data-i18n-alt="testimonial_gyen_alt"
          />
          <div class="author-info">
            <p class="author-name" data-i18n="testimonial_gyen_name">
              Gyen Lekshay
            </p>
            <p class="author-role" data-i18n="testimonial_gyen_role">
              Senior Teacher
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* --- Testimonials Section --- */
  .testimonials-section {
    padding: 20px 20px;
    background-color: white;
    color: #333;
    overflow: hidden;
    text-align: center;
  }

  .testimonials-header {
    max-width: 1200px; /* Matched to container width */
    margin: 0 auto 20px auto;
    padding: 0 20px;
    position: relative; /* Needed for navigation button positioning */
  }

  .testimonials-title {
    font-size: 2rem;
    color: #001f3f;
    margin-bottom: 15px;
    position: relative;
    padding-bottom: 12px;
    font-weight: 700;
  }

  .testimonials-title::after {
    content: "";
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 0;
    width: 80px;
    height: 4px;
    background-color: #001f3f;
    border-radius: 2px;
  }

  .testimonials-subtitle {
    font-size: 1.1rem;
    color: #555;
    line-height: 1.7;
    margin-top: 15px;
  }

  /* 🌟 NEW: Navigation Styles (Desktop Only) 🌟 */
  .testimonials-navigation {
    display: none; /* Default hidden, shown via JS/media query on desktop */
    position: absolute;
    right: 0;
    top: 20px;
  }

  .testo-prev-btn,
  .testo-next-btn {
    background: #001f3f;
    color: white;
    border: none;
    width: 35px;
    height: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 4px;
    margin-left: 5px;
    transition:
      background 0.2s,
      opacity 0.2s;
  }

  .testo-prev-btn:hover,
  .testo-next-btn:hover {
    background: #002b59;
  }

  .testo-prev-btn.disabled,
  .testo-next-btn.disabled {
    opacity: 0.5;
    cursor: default;
    background: #001f3f; /* Keep color consistent */
  }

  /* 🌟 NEW: Wrapper to crop the container (crucial for slider) 🌟 */
  .testo-slider-wrapper {
    overflow: hidden;
    margin: 0 auto;
    max-width: 1200px;
  }

  .testimonials-container {
    /* Max width is managed by the wrapper */
    margin: 0 auto;
    display: flex;
    flex-wrap: nowrap; /* Forces cards onto one line for slider */
    justify-content: flex-start;
    gap: 30px;
    transition: transform 0.3s ease-in-out; /* Enables smooth sliding */
  }

  .testimonial-card {
    background-color: #ffffff;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    text-align: left;

    /* 🌟 DESKTOP SLIDER: 3 cards visible, calculation based on 30px gap 🌟 */
    flex: 0 0 calc(33.333% - 20px);
    min-width: 250px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  }

  .quote-icon {
    font-size: 2.5rem;
    color: #001f3f;
    margin-bottom: 15px;
  }

  .testimonial-text {
    font-size: 1.0625rem; /* ~17px for consistency */
    line-height: 1.7;
    color: #555;
    margin-bottom: 25px;
    flex-grow: 1;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    margin-top: auto;
  }

  .testimonial-author img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    margin-right: 15px;
    border: 2px solid #ffc107;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .author-info {
    text-align: left;
  }

  .author-name {
    font-size: 1.05rem;
    font-weight: 600;
    color: #001f3f;
    margin: 0;
  }

  .author-role {
    font-size: 0.85rem;
    color: #777;
    margin: 0;
  }

  /* --- Responsive Adjustments for Testimonials Section --- */

  /* 🌟 DESKTOP (Min-width: 993px) - Ensure Navigation is VISIBLE 🌟 */
  @media (min-width: 993px) {
    .testimonials-navigation {
      display: flex;
    }
  }

  /* Tablets and smaller desktops (max-width: 992px) */
  @media (max-width: 992px) {
    .testimonials-section {
      padding: 60px 15px;
    }

    .testimonials-container {
      flex-wrap: wrap; /* Allow cards to wrap to 2 columns */
      justify-content: center;
    }

    /* 🌟 TABLET: 2 columns, reset flex-grow 🌟 */
    .testimonial-card {
      flex: 1 1 calc(50% - 15px); /* Two columns on tablets, adjusted for 25px gap */
      padding: 25px;
      min-width: 250px;
    }

    /* Hide the desktop slider wrapper constraint */
    .testo-slider-wrapper {
      overflow: visible;
    }

    .testimonials-title {
      font-size: 2.2rem;
      margin-bottom: 12px;
      padding-bottom: 10px;
    }

    .testimonials-title::after {
      width: 70px;
      height: 3px;
    }

    .testimonials-subtitle {
      font-size: 1rem;
      margin-top: 10px;
    }

    .testimonials-container {
      gap: 25px;
    }

    .quote-icon {
      font-size: 2rem;
    }

    .testimonial-text {
      font-size: 1rem;
      margin-bottom: 20px;
    }

    .testimonial-author img {
      width: 50px;
      height: 50px;
      margin-right: 12px;
    }

    .author-name {
      font-size: 1rem;
    }

    .author-role {
      font-size: 0.8rem;
    }
  }

  /* Mobile devices (max-width: 768px) */
  @media (max-width: 768px) {
    .testimonials-section {
      padding: 50px 10px;
    }

    .testimonials-header {
      margin-bottom: 40px;
    }

    /* 🌟 MOBILE: 1 column 🌟 */
    .testimonial-card {
      flex: 1 1 100%;
      max-width: 400px;
      margin: 0 auto;
      padding: 20px;
    }

    .testimonials-title {
      font-size: 1.8rem;
      margin-bottom: 10px;
      padding-bottom: 8px;
    }

    .testimonials-title::after {
      width: 60px;
      height: 2px;
    }

    .testimonials-subtitle {
      font-size: 0.9rem;
      margin-top: 8px;
    }

    .testimonials-container {
      gap: 20px;
    }

    .quote-icon {
      font-size: 1.8rem;
    }

    .testimonial-text {
      font-size: 0.85rem;
      margin-bottom: 15px;
    }

    .testimonial-author img {
      width: 45px;
      height: 45px;
      margin-right: 10px;
    }

    .author-name {
      font-size: 0.9rem;
    }

    .author-role {
      font-size: 0.75rem;
    }
  }

  /* Very small mobile devices (max-width: 480px) */
  @media (max-width: 480px) {
    .testimonials-section {
      padding: 30px 10px;
    }

    .testimonials-header {
      margin-bottom: 30px;
    }

    .testimonials-title {
      font-size: 1.6rem;
      margin-bottom: 8px;
      padding-bottom: 6px;
    }

    .testimonials-container {
      gap: 15px;
    }

    .testimonial-card {
      padding: 15px;
    }

    .quote-icon {
      font-size: 1.5rem;
    }

    .testimonial-text {
      font-size: 0.8rem;
      margin-bottom: 12px;
    }

    .testimonial-author img {
      width: 40px;
      height: 40px;
      margin-right: 8px;
    }

    .author-name {
      font-size: 0.85rem;
    }

    .author-role {
      font-size: 0.7rem;
    }
  }
</style>

<script is:inline>
  function setupTestimonialsSlider() {
    const wrapper = document.querySelector(".testo-slider-wrapper");
    const container = document.querySelector(".testimonials-container");
    const nextBtn = document.querySelector(".testo-next-btn");
    const prevBtn = document.querySelector(".testo-prev-btn");

    if (!container || !wrapper || !nextBtn || !prevBtn) return;

    // We only want the slider logic to run on large screens (Desktop)
    // where we can display 4 cards, but only 3 are visible at once.
    if (window.innerWidth <= 992) {
      // If mobile/tablet, hide navigation and exit slider logic
      if (nextBtn) nextBtn.style.display = "none";
      if (prevBtn) prevBtn.style.display = "none";
      container.style.transform = `translateX(0px)`;
      container.style.flexWrap = "wrap"; // Ensure wrapping on smaller screens
      return;
    }

    // Desktop Slider Setup (3 cards visible, total 4 cards)
    if (nextBtn) nextBtn.style.display = "flex";
    if (prevBtn) prevBtn.style.display = "flex";
    container.style.flexWrap = "nowrap"; // Ensure no wrapping on desktop slider

    const card = container.querySelector(".testimonial-card");
    if (!card) return;

    // Calculate the exact step size (Card Width + Gap)
    const cardGap = 30; // Matches CSS gap
    // Use offsetWidth to get the card's calculated width
    const cardStepSize = card.offsetWidth + cardGap;

    // The total distance to slide to reveal the 4th card (one card step)
    const slideOffset = -cardStepSize;

    let isSlid = false;

    function updateSlider() {
      container.style.transform = `translateX(${isSlid ? slideOffset : 0}px)`;

      // Control button state based on the slide position
      prevBtn.classList.toggle("disabled", !isSlid);
      nextBtn.classList.toggle("disabled", isSlid);
    }

    // --- Event Listeners ---
    nextBtn.onclick = () => {
      if (!isSlid) {
        isSlid = true;
        updateSlider();
      }
    };

    prevBtn.onclick = () => {
      if (isSlid) {
        isSlid = false;
        updateSlider();
      }
    };

    // Reset and update on initial load
    isSlid = false;
    updateSlider();

    // Recalculate on window resize to ensure correct offset
    window.addEventListener("resize", () => {
      // Recalculate everything, in case a card has changed size
      setupTestimonialsSlider();
    });
  }

  // Astro View Transition Compatibility:
  document.addEventListener("DOMContentLoaded", setupTestimonialsSlider);
  document.addEventListener("astro:page-load", setupTestimonialsSlider);
</script>
