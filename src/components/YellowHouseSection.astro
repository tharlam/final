---
// src/components/YellowHouseSection.astro
---

<section class="house-section yellow-house-section" data-aos="fade-up">
    <div class="container">
        <div class="house-content-grid">
            <div class="house-text" data-aos="fade-right">
                <p data-i18n="yellow_house_paragraph_1">
                    The **Yellow House (Deshung House): Vibrant Energy &
                    Agility**. The Yellow House, also known as Deshung House,
                    radiates vibrant energy, enthusiasm, and exceptional
                    agility. Members of Yellow House are often found leading the
                    charge in fast-paced sports, showcasing their quick reflexes
                    and dynamic movement. They bring an infectious positivity to
                    every game and training session.
                </p>
                <p data-i18n="yellow_house_paragraph_2">
                    This house encourages creativity in play and celebrates
                    individual flair, while also valuing fair play and
                    sportsmanship. Yellow House is about enjoying the journey,
                    embracing challenges with a smile, and bringing a lively
                    spirit to the academy's sports arena.
                </p>
                <div class="house-motto">
                    <strong>Motto:</strong> "Agility, Positivity, Enthusiasm."
                </div>
            </div>

            <div class="house-image" data-aos="fade-left">
                <img
                    src="/final/ho-3.webp"
                    alt="Yellow House students showing agility and Deshung House spirit"
                    class="responsive-image"
                    data-i18n-alt="yellow_house_image_alt"
                    loading="lazy"
                />
            </div>
        </div>
    </div>
</section>

<style>
    /* --- Component-Specific Styles --- */
    .yellow-house-section {
        background-color: #fffacd;
        padding: 70px 0;
    }

    /* CRITICAL DESKTOP FIX: Text on left, Image on right 
   (Default flex-direction: row; property is used by simply removing row-reverse) 
*/
    .yellow-house-section .house-content-grid {
        flex-direction: row;
    }

    /* --- Essential Structural/General House CSS (Desktop/Base) --- */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0px;
    }
    .house-content-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 60px;
        align-items: center;
        justify-content: center;
    }
    .house-text {
        flex: 1 1 450px;
        min-width: 300px;
        max-width: 550px;
        text-align: left;
    }
    .house-text p {
        font-size: 16px;
        line-height: 1.7;
        color: #444;
        margin-bottom: 20px;
    }
    .house-text p:first-child {
        font-size: 17px;
        color: #001f3f;
        font-weight: 500;
    }
    .house-image {
        flex: 1 1 350px;
        min-width: 300px;
        max-width: 1200px;
        text-align: center;
    }
    .responsive-image {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
    .house-motto {
        font-style: italic;
        font-size: 16px;
        font-weight: 500;
        color: #001f3f;
        margin-top: 25px;
        padding: 10px 15px;
        background-color: rgba(0, 31, 63, 0.05);
        border-left: 4px solid #001f3f;
        border-radius: 4px;
    }

    /* ------------------------------------------------------------------ */
    /* --- MOBILE MEDIA QUERIES (Text on Top / Minimal Gap Fix) --- */
    /* ------------------------------------------------------------------ */

    @media (max-width: 992px) {
        .yellow-house-section {
            padding: 60px 0;
        }
        .house-content-grid {
            gap: 30px;
            flex-direction: column;
        } /* Forces Text-on-Top on mobile */
    }

    @media (max-width: 768px) {
        .yellow-house-section {
            padding: 40px 0;
        }
        .container {
            padding: 0 15px;
        }
        .house-content-grid {
            gap: 10px;
            flex-direction: column;
            align-items: center;
        }
        .house-text,
        .house-image {
            width: 100%;
            max-width: 500px;
        }

        /* CRITICAL FIX: Ensure minimal gap below text/above image */
        .house-image {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
        .house-image .responsive-image {
            margin-top: 0 !important;
            display: block;
        }

        .house-text p {
            font-size: 15px;
        }
        .house-text p:first-child {
            font-size: 16px;
        }
    }

    @media (max-width: 480px) {
        .yellow-house-section {
            padding: 30px 0;
        }
        .container {
            padding: 0 10px;
        }
        .house-content-grid {
            gap: 5px;
        }
        .house-image .responsive-image {
            display: block;
            margin-top: 0 !important;
        }
        .house-text p {
            font-size: 14px;
        }
        .house-text p:first-child {
            font-size: 15px;
        }
        .house-motto {
            font-size: 15px;
        }
    }
</style>
