---
// This is the frontmatter block. It's required here to access BASE_PATH.
const BASE_PATH = import.meta.env.BASE_URL; 
---

<section id="message" class="principal-section">
  <div class="principal-container">
    
    <div class="principal-image" data-aos="fade-right">
      <img
        src={`${BASE_PATH}prin.webp`} 
        alt="Photo of the Principal"
        data-i18n-alt="principal_photo_alt"
      />
    </div>

    <div class="principal-content" data-aos="fade-left">
      <p class="principal-name" data-i18n="principal_name">Tenpa Gyaltsen</p>
      
      <p class="principal-title" data-i18n="principal_title">
        Principal of Tharlam-Academy
      </p>

      <h3 class="principal-heading" data-i18n="principal_message_heading">
        Message from the Principal
      </h3>

      <blockquote class="principal-quote">
        <span data-i18n="principal_quote_text">
          "Supporting a child’s education is like planting the seed of wisdom
          in this world. We invite you to walk this path with us—gently,
          generously, and with joy."
        </span>
      </blockquote>

      <p class="buddhist-inspiration">
        <strong data-i18n="buddhist_inspiration_strong">Related Buddhist Inspiration:</strong>
        <br />
        <span data-i18n="buddhist_inspiration_text">
          "As a lamp lights another lamp, thousands of lamps can be lit from
          one. So too, wisdom shared spreads boundless benefit."
        </span>
      </p>
    </div>

  </div>
</section>

<style>
  /* --- Section Wrapper --- */
  .principal-section {
    /* Vertical padding from root */
    padding: var(--space-section) 0;
    color: var(--color-text);
    background-color: transparent;
    overflow: hidden;
  }

  /* --- Main Container --- */
  .principal-container {
    width: var(--container-width);
    max-width: var(--max-container);
    margin: 0 auto;
    padding: var(--space-container);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    /* Space between image and text from root */
    gap: var(--space-gap);
  }

  /* --- Image Styling --- */
  .principal-image {
    flex-shrink: 0;
    /* We use a clamp for the circle size to keep it responsive */
    width: clamp(180px, 35vw, 300px); 
    height: clamp(180px, 35vw, 300px);
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--color-primary);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .principal-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Text Content Area --- */
  .principal-content {
    flex: 1 1 320px;
    max-width: 750px;
    text-align: left;
  }

  /* Titles and Headings using root variables */
  .principal-name, 
  .principal-heading {
    font-size: var(--font-heading);
    color: var(--color-heading);
    font-weight: 700;
    margin-bottom: var(--space-small);
  }

  .principal-title {
    font-size: var(--font-body);
    color: var(--color-text);
    margin-bottom: var(--space-gap);
    opacity: 0.8;
  }

  /* Body text and quotes using root variables */
  .principal-quote {
    font-size: var(--font-body);
    color: var(--color-text);
    font-style: italic;
    line-height: 1.8;
    margin: 0;
    /* Small spacing from root */
    padding-bottom: var(--space-small);
  }

  .buddhist-inspiration {
    font-size: var(--font-body);
    color: var(--color-text);
    margin-top: var(--space-gap);
    /* Decorative line using primary color variable */
    border-top: 1px solid var(--color-primary);
    padding-top: var(--space-small);
  }

  .buddhist-inspiration strong {
    color: var(--color-heading);
  }

  /* --- Single Structural Media Query --- */
  /* This ONLY handles the layout shift (switching from Row to Column) */
  @media (max-width: 768px) {
    .principal-container {
      flex-direction: column;
      text-align: center;
    }
    
    .principal-content {
      text-align: center;
    }
  }
</style>