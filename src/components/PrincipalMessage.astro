---
// Required to access BASE_PATH
const BASE_PATH = import.meta.env.BASE_URL;
---

<section id="message" class="principal-section">
  <div class="principal-container">
    
    <div class="principal-image" data-aos="fade-right">
      <img
        src={`${BASE_PATH}private-assets/prin.webp`} 
        data-i18n-alt="principal_photo_alt"
      />
    </div>

    <div class="principal-content" data-aos="fade-left">
      <p class="principal-name" data-i18n="principal_name"></p>
      
      <p class="principal-title" data-i18n="principal_title"></p>

      <p class="principal-heading" data-i18n="principal_message_heading"></p>

      <blockquote class="principal-quote">
        <span data-i18n="principal_quote_text"></span>
      </blockquote>

      <p class="buddhist-inspiration">
        <strong data-i18n="buddhist_inspiration_label"></strong>
        <br />
        <span data-i18n="buddhist_inspiration_p1"></span>
      </p>
    </div>

  </div>
</section>

<style>
/* --- Section Wrapper --- */
.principal-section {
  padding: var(--space-section) 0;
  color: var(--color-text);
  background-color: transparent;
  overflow: hidden;
}

/* --- Main Container --- */
.principal-container {
  width: var(--container-width);
  max-width: var(--max-container);
  margin: 0 auto;
  padding: var(--space-container);
  display: grid;
  grid-template-columns: 0.5fr 2fr;
  gap: var(--space-gap);
  align-items: center;
}

/* --- Image Styling --- */
.principal-image {
  width: clamp(180px, 35vw, 300px);
  height: clamp(180px, 35vw, 300px);
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid var(--color-primary);
  display: flex;
  justify-content: center;
  align-items: center;
}
.principal-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* --- Text Content Area --- */
.principal-content {
  max-width: 750px;
  text-align: left;
}

/* --- All Text Uses Body Font Size --- */
.principal-name,
.principal-title,
.principal-heading {
  font-size: var(--font-body);
  font-family: inherit;
  color: var(--color-heading);
  font-weight: 600;
  margin-bottom: var(--space-small);
}

.principal-title {
  color: var(--color-text);
  opacity: 0.8;
  margin-bottom: var(--space-small);
}

.principal-heading {
  color: var(--color-heading);
  font-weight: 600;
  margin-bottom: var(--space-small);
}

/* --- Quote Styling --- */
.principal-quote {
  font-size: var(--font-body);
  font-family: inherit;
  color: var(--color-text);
  font-style: italic;
  line-height: var(--line-height-text);
  margin: 0;
  padding-bottom: var(--space-small);
}

/* --- Buddhist Inspiration --- */
.buddhist-inspiration {
  font-size: var(--font-body);
  font-family: inherit;
  color: var(--color-text);
  margin-top: var(--space-gap);
  border-top: 1px solid var(--color-primary);
  padding-top: var(--space-small);
}
.buddhist-inspiration strong {
  color: var(--color-heading);
  font-weight: 600;
}

/* --- Single Breakpoint --- */
@media (max-width: 768px) {
  .principal-container {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .principal-image {
    margin: 0 auto;
  }

  .principal-content {
    text-align: center;
    margin-top: var(--space-gap);
  }
}

</style>
