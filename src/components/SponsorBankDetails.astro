<style>
    .bank-transfer-info-section {
        padding: var(--space-section) 0;
        background-color: var(--color-text-white);
    }

    .container {
        width: var(--container-width);
        max-width: var(--max-container);
        margin-inline: auto;
        padding: var(--space-container);
    }

    .bank-transfer-card {
        display: flex;
        width: 100%;
        margin: 0 auto;
        background-color: var(--color-text-white);
        border-radius: var(--space-small);
        box-shadow: 0 5px 25px var(--shadow-light);
        overflow: hidden;
        border: 1px solid var(--color-text);
    }

    /* Tab Buttons */
    .bank-tab-buttons-wrap {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        background-color: var(--color-primary);
        padding: var(--space-small) 0;
        min-width: 200px;
    }

    .bank-tab-button {
        background-color: transparent;
        color: var(--color-text-white);
        border: none;
        padding: var(--space-small) var(--space-gap);
        text-align: left;
        cursor: pointer;
        transition:
            background-color 0.2s,
            color 0.2s;
        font-size: var(--font-body);
        font-weight: 500;
        display: flex;
        align-items: center;
    }

    .bank-tab-button i {
        font-size: var(--font-body);
        margin-right: var(--space-small);
    }

    .bank-tab-button:hover {
        background-color: var(--color-primary); /* hover green */
    }

    .bank-tab-button.active {
        background-color: var(--color-primary);
        color: var(--color-text-white);
        font-weight: 600;
    }

    /* Details Content */
    .bank-details-display {
        flex: 1;
        padding: var(--space-gap);
        background-color: var(--color-text-white);
    }

    .bank-details-content {
        display: none;
    }

    .bank-details-content.active {
        display: block;
    }

    .bank-details-title {
        font-size: var(--font-body);
        font-weight: 600;
        color: var(--color-heading);
        margin-bottom: var(--space-small);
        border-bottom: 2px solid var(--color-text);
        padding-bottom: var(--space-small);
    }

    .bank-details-content p {
        font-size: var(--font-body);
        line-height: var(--line-height-text);
        color: var(--color-text);
        margin-bottom: var(--space-gap);
    }

    /* Grid Layout */
    .details-grid {
        display: flex;
        flex-direction: column;
        gap: var(--space-small);
        border: 1px solid var(--color-text);
        padding: var(--space-small);
        border-radius: var(--space-small);
        background-color: var(--color-text-white);
    }

    .detail-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: var(--space-small);
        border-bottom: 1px dashed var(--color-text);
        font-size: var(--font-body);
    }

    .detail-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .detail-item strong {
        color: var(--color-text-dark);
        font-weight: 600;
        flex-shrink: 0;
        margin-right: var(--space-small);
    }

    /* Copy Group */
    .copy-group {
        display: flex;
        align-items: center;
        position: relative;
        gap: var(--space-small);
    }

    .copy-target {
        font-family: "Courier New", Courier, monospace;
        color: var(--color-text-dark);
        font-weight: 600;
        font-size: var(--font-body);
        flex-grow: 1;
        text-align: right;
        overflow-wrap: break-word;
    }

    .copy-button {
        background-color: var(--color-primary);
        border: none;
        color: var(--color-text-white);
        width: 30px;
        height: 30px;
        border-radius: var(--space-small);
        box-shadow: 0 2px 5px var(--shadow-medium);
        cursor: pointer;
        transition:
            background-color 0.2s,
            transform 0.1s;
        flex-shrink: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: var(--font-body);
    }

    .copy-button:hover {
        background-color: var(--color-primary);
        transform: translateY(-1px);
    }

    .copy-button:active {
        transform: translateY(0);
    }

    /* Copied Message */
    .copy-message {
        position: absolute;
        top: 50%;
        right: 38px;
        transform: translateY(-50%);
        padding: var(--space-small);
        background-color: var(--color-primary);
        color: var(--color-text-white);
        border-radius: var(--space-small);
        font-size: var(--font-body);
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.2s,
            visibility 0.2s,
            right 0.2s;
        pointer-events: none;
        white-space: nowrap;
        z-index: 10;
    }

    .copy-message.show {
        opacity: 1;
        visibility: visible;
        right: 35px;
    }

    /* --- Single Breakpoint at 768px --- */
    @media (max-width: 768px) {
        .bank-transfer-card {
            flex-direction: column;
        }
        .bank-tab-buttons-wrap {
            flex-direction: row;
            min-width: unset;
            padding: 0;
            border-bottom: 5px solid var(--color-primary);
        }
        .bank-tab-button {
            flex: 1;
            text-align: center;
            justify-content: center;
        }
        .bank-details-display {
            padding: var(--space-small);
        }
        .bank-details-title {
            margin-bottom: var(--space-small);
        }
        .details-grid {
            padding: var(--space-small);
        }
    }
</style>

<script is:inline>
    /**
     * Initializes tab switching and copy-to-clipboard functionality,
     * designed to be safe for Astro View Transitions (soft navigation).
     */
    function initializeBankDetails() {
        const tabButtons = document.querySelectorAll(".bank-tab-button");
        const contentAreas = document.querySelectorAll(".bank-details-content");
        const copyButtons = document.querySelectorAll(".copy-button");

        if (tabButtons.length === 0) return;

        // --- Tab Switching ---
        const switchTab = (bankType) => {
            tabButtons.forEach((btn) => {
                btn.classList.remove("active");
                btn.setAttribute("aria-selected", "false");
            });
            contentAreas.forEach((content) =>
                content.classList.remove("active"),
            );

            const activeBtn = document.querySelector(
                `.bank-tab-button[data-bank="${bankType}"]`,
            );
            const activeContent = document.getElementById(
                `${bankType}-bank-details`,
            );

            if (activeBtn) {
                activeBtn.classList.add("active");
                activeBtn.setAttribute("aria-selected", "true");
            }
            if (activeContent) activeContent.classList.add("active");
        };

        const tabButtonListener = (event) => {
            const bankType = event.currentTarget.dataset.bank;
            switchTab(bankType);
        };

        // --- Copy-to-Clipboard ---
        const copyButtonListener = async (event) => {
            const copyGroup = event.currentTarget.closest(".copy-group");
            const copyTarget = copyGroup.querySelector(".copy-target");
            const copyMessage = copyGroup.querySelector(".copy-message");

            if (copyTarget && navigator.clipboard) {
                try {
                    await navigator.clipboard.writeText(
                        copyTarget.textContent.trim(),
                    );
                    copyMessage.classList.add("show");
                    setTimeout(
                        () => copyMessage.classList.remove("show"),
                        1500,
                    );
                } catch (err) {
                    console.error("Could not copy text: ", err);
                }
            }
        };

        // --- Listener Management ---
        tabButtons.forEach((button) => {
            button.removeEventListener("click", tabButtonListener);
            button.addEventListener("click", tabButtonListener);
        });

        copyButtons.forEach((button) => {
            button.removeEventListener("click", copyButtonListener);
            button.addEventListener("click", copyButtonListener);
        });

        // --- Default Tab ---
        switchTab("nepal");
    }

    // Run on initial load and Astro soft navigation
    document.addEventListener("DOMContentLoaded", initializeBankDetails);
    document.addEventListener("astro:page-load", initializeBankDetails);
</script>
