---
// src/components/SponsorBankDetails.astro
// Defines the tabbed section for bank transfer details.
// Features: Two tabs (Local/International), reduced text size, and clear copy buttons with icons.
---

<section id="bank-transfer-info" class="bank-transfer-info-section" data-aos="fade-up">
    <div class="container">
        <div class="bank-transfer-card">
            <div
                class="bank-tab-buttons-wrap"
                data-aos="fade-right"
                data-aos-delay="100"
            >
                <button
                    class="bank-tab-button active"
                    data-bank="nepal"
                    data-i18n="btn_nepal_short"
                >
                    <i class="fas fa-money-check-alt"></i> Local
                </button>
                <button
                    class="bank-tab-button"
                    data-bank="outside-nepal"
                    data-i18n="btn_outside_nepal_short"
                >
                    <i class="fas fa-globe"></i> International
                </button>
            </div>

            <div
                class="bank-details-display"
                data-aos="fade-left"
                data-aos-delay="200"
            >
                <div
                    id="nepal-bank-details"
                    class="bank-details-content active"
                >
                    <h3 data-i18n="local_bank_details_title">
                        Local Bank Details
                    </h3>
                    <p data-i18n="local_bank_details_description">
                        For transfers within Nepal, please use the following details:
                    </p>
                    <div class="details-grid">
                        <div class="detail-item">
                            <strong><span data-i18n="bank_name_label">Bank Name</span>:</strong>
                            <div class="copy-group">
                                <span
                                    class="copy-target"
                                    data-i18n="bank_name_nepal"
                                    >Nepal Investment Mega Bank Ltd.</span
                                >
                                <button
                                    class="copy-button"
                                    aria-label="Copy Bank Name"
                                >
                                    <i class="fas fa-clipboard"></i> 
                                </button>
                                <span
                                    class="copy-message"
                                    data-i18n="copied_message">Copied!</span
                                >
                            </div>
                        </div>
                        <div class="detail-item">
                            <strong><span data-i18n="account_name_label">Account Name</span>:</strong>
                            <div class="copy-group">
                                <span
                                    class="copy-target"
                                    data-i18n="account_name_nepal"
                                    >Tharlam Sakya Dharma Vihara</span
                                >
                                <button
                                    class="copy-button"
                                    aria-label="Copy Account Name"
                                >
                                    <i class="fas fa-clipboard"></i>
                                </button>
                                <span
                                    class="copy-message"
                                    data-i18n="copied_message">Copied!</span
                                >
                            </div>
                        </div>
                        <div class="detail-item">
                            <strong><span data-i18n="account_number_label">Account Number</span>:</strong>
                            <div class="copy-group">
                                <span
                                    class="copy-target"
                                    data-i18n="account_number_nepal"
                                    >02405020257510</span
                                >
                                <button
                                    class="copy-button"
                                    aria-label="Copy Account Number"
                                >
                                    <i class="fas fa-clipboard"></i>
                                </button>
                                <span
                                    class="copy-message"
                                    data-i18n="copied_message">Copied!</span
                                >
                            </div>
                        </div>
                        <div class="detail-item">
                            <strong><span data-i18n="branch_name_label">Branch Name</span>:</strong>
                            <div class="copy-group">
                                <span
                                    class="copy-target"
                                    data-i18n="branch_name_nepal">Bouddha</span
                                >
                                <button
                                    class="copy-button"
                                    aria-label="Copy Branch Name"
                                >
                                    <i class="fas fa-clipboard"></i>
                                </button>
                                <span
                                    class="copy-message"
                                    data-i18n="copied_message">Copied!</span
                                >
                            </div>
                        </div>
                    </div>
                    </div>

                <div
                    id="outside-nepal-bank-details"
                    class="bank-details-content"
                >
                    <h3 data-i18n="international_bank_details_title">
                        International Bank Details
                    </h3>
                    <p
                        class="international-transfer-guidance"
                        data-i18n="international_bank_details_description"
                    >
                        For international transfers, please use these details:
                    </p>
                    
                    <div class="details-grid">
                        <div class="detail-item">
                            <strong><span data-i18n="bank_name_label">Bank Name</span>:</strong>
                            <div class="copy-group">
                                <span
                                    class="copy-target"
                                    data-i18n="bank_name_international"
                                    >Prabhu Bank Limited</span
                                >
                                <button
                                    class="copy-button"
                                    aria-label="Copy Bank Name"
                                >
                                    <i class="fas fa-clipboard"></i>
                                </button>
                                <span
                                    class="copy-message"
                                    data-i18n="copied_message">Copied!</span
                                >
                            </div>
                        </div>
                        <div class="detail-item">
                            <strong><span data-i18n="account_name_label">Account Name</span>:</strong>
                            <div class="copy-group">
                                <span
                                    class="copy-target"
                                    data-i18n="account_name_international"
                                    >THARLAM SANSAG NAMAGYAL LING SAKYA DHARMA
                                    BIHAR</span
                                >
                                <button
                                    class="copy-button"
                                    aria-label="Copy Account Name"
                                >
                                    <i class="fas fa-clipboard"></i>
                                </button>
                                <span
                                    class="copy-message"
                                    data-i18n="copied_message">Copied!</span
                                >
                            </div>
                        </div>
                        <div class="detail-item">
                            <strong><span data-i18n="account_number_label">Account Number</span>:</strong>
                            <div class="copy-group">
                                <span
                                    class="copy-target"
                                    data-i18n="account_number_international"
                                    >3260155862000019</span
                                >
                                <button
                                    class="copy-button"
                                    aria-label="Copy Account Number"
                                >
                                    <i class="fas fa-clipboard"></i>
                                </button>
                                <span
                                    class="copy-message"
                                    data-i18n="copied_message">Copied!</span
                                >
                            </div>
                        </div>
                        <div class="detail-item">
                            <strong><span data-i18n="swift_bic_code_label">SWIFT/BIC Code</span>:</strong>
                            <div class="copy-group">
                                <span
                                    class="copy-target"
                                    data-i18n="swift_bic_code_international"
                                    >PRVUNPKA</span
                                >
                                <button
                                    class="copy-button"
                                    aria-label="Copy SWIFT/BIC Code"
                                >
                                    <i class="fas fa-clipboard"></i>
                                </button>
                                <span
                                    class="copy-message"
                                    data-i18n="copied_message">Copied!</span
                                >
                            </div>
                        </div>
                        <div class="detail-item">
                            <strong><span data-i18n="bank_address_label">Bank Address</span>:</strong>
                            <div class="copy-group">
                                <span
                                    class="copy-target"
                                    data-i18n="bank_address_international"
                                    >Boudha branch</span
                                >
                                <button
                                    class="copy-button"
                                    aria-label="Copy Bank Address"
                                >
                                    <i class="fas fa-clipboard"></i>
                                </button>
                                <span
                                    class="copy-message"
                                    data-i18n="copied_message">Copied!</span
                                >
                            </div>
                        </div>
                        <div class="detail-item">
                            <strong><span data-i18n="beneficiary_address_label">Beneficiary Address</span>:</strong>
                            <div class="copy-group">
                                <span
                                    class="copy-target"
                                    data-i18n="beneficiary_address_international"
                                    >Boudha-6, Kathmandu, Nepal</span
                                >
                                <button
                                    class="copy-button"
                                    aria-label="Copy Beneficiary Address"
                                >
                                    <i class="fas fa-clipboard"></i>
