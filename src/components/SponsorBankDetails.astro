</section>

<style>
    /* ------------------------------------------------------------------ */
    /* --- SHARED STRUCTURE STYLES --- */
    /* ------------------------------------------------------------------ */
    .container {
        max-width: 1200px; 
        margin: 0 auto;
        padding: 0px; 
    }
    .bank-transfer-info-section {
        padding: 70px 0; 
        background-color: #f7f9fb;
    }
    .bank-transfer-card {
        display: flex;
        max-width: 100%;
        width: 100%;
        margin: 0 auto;
        background-color: white;
        border-radius: 10px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        border: 1px solid #e0e0e0;
    }

    /* ------------------------------------------------------------------ */
    /* --- LEFT SIDE: MENU BUTTONS --- */
    /* ------------------------------------------------------------------ */
    .bank-tab-buttons-wrap {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        background-color: var(--color-dark-blue, #001f3f);
        padding: 10px 0;
        min-width: 200px; 
    }
    .bank-tab-button {
        background-color: transparent;
        color: rgba(255, 255, 255, 0.7);
        border: none;
        padding: 15px 20px;
        text-align: left;
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s;
        font-size: 1rem; 
        font-weight: 500;
        display: flex;
        align-items: center;
    }
    .bank-tab-button i {
        font-size: 1.1em;
        margin-right: 8px;
    }
    .bank-tab-button:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: white;
    }
    .bank-tab-button.active {
        background-color: var(--color-primary-green, #28a745);
        color: white;
        position: relative;
        font-weight: 600;
    }

    /* ------------------------------------------------------------------ */
    /* --- RIGHT SIDE: DETAILS CONTENT --- */
    /* ------------------------------------------------------------------ */
    .bank-details-display {
        flex: 1;
        padding: 40px;
        background-color: #f7f9fb;
    }
    .bank-details-content {
        display: none;
    }
    .bank-details-content.active {
        display: block;
    }
    .bank-details-content h3 {
        font-size: 1.6rem;
        color: var(--color-dark-blue, #001f3f);
        margin-bottom: 20px;
        border-bottom: 2px solid #ddd;
        padding-bottom: 10px;
    }
    .bank-details-content p {
        font-size: 1rem;
        line-height: 1.6;
        color: #555;
        margin-bottom: 25px;
    }
    
    /* Grid Layout for Details */
    .details-grid {
        display: flex;
        flex-direction: column;
        gap: 12px; /* Tighter spacing */
        border: 1px solid #e0e0e0;
        padding: 15px;
        border-radius: 6px;
        background-color: #fff;
    }
    .detail-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 7px;
        border-bottom: 1px dashed #eee;
        font-size: 0.95rem; /* Reduced overall text size */
    }
    .detail-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }
    .detail-item strong {
        color: #333;
        font-weight: 600;
        flex-shrink: 0;
        margin-right: 15px;
    }
    
    /* Notes (Styles are kept but the elements are removed in the HTML) */
    .note {
        margin-top: 30px;
        padding: 15px;
        border-radius: 5px;
        font-style: italic;
        font-size: 0.9rem;
    }
    .note-local {
        background-color: #e6f7ff;
        border-left: 5px solid #007bff;
    }
    .note-international {
        background-color: #fff3e6;
        border-left: 5px solid #ff9900;
    }

    /* ------------------------------------------------------------------ */
    /* --- COPY GROUP STYLES (Focus on clarity) --- */
    /* ------------------------------------------------------------------ */
    .copy-group {
        display: flex;
        align-items: center;
        position: relative;
        gap: 8px; /* Tighter gap */
    }
    .copy-target {
        font-family: 'Courier New', Courier, monospace;
        color: #000; /* Darker color for data emphasis */
        font-weight: 600;
        font-size: 0.95rem; /* Reduced overall text size */
        flex-grow: 1;
        text-align: right;
        overflow-wrap: break-word; /* Ensure long account names wrap if necessary */
    }
    .copy-button {
        background-color: var(--color-primary-green, #28a745); /* Highlight button clearly */
        border: none;
        color: white;
        width: 30px;
        height: 30px;
        border-radius: 3px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2); 
        cursor: pointer;
        transition: background-color 0.2s, transform 0.1s;
        flex-shrink: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 0.85rem;
    }
    .copy-button:hover {
        background-color: #1e8736;
        transform: translateY(-1px);
    }
    .copy-button:active {
        transform: translateY(0);
    }
    
    /* 'Copied' Pop-up Message */
    .copy-message {
        position: absolute;
        top: 50%;
        right: 38px; /* Position next to the button */
        transform: translateY(-50%);
        padding: 4px 8px;
        background-color: var(--color-dark-blue, #001f3f); /* Dark background for pop-up */
        color: white;
        border-radius: 4px;
        font-size: 0.75rem;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s, visibility 0.2s, right 0.2s;
        pointer-events: none;
        white-space: nowrap;
        z-index: 10;
    }
    .copy-message.show {
        opacity: 1;
        visibility: visible;
        right: 35px; /* Slight movement animation */
    }


    /* ------------------------------------------------------------------ */
    /* --- MEDIA QUERIES (Mobile and Tablet Refinements) --- */
    /* ------------------------------------------------------------------ */

    @media (max-width: 992px) { 
        .bank-transfer-card {
            flex-direction: column; /* Stacks menu and content */
        }
        .bank-tab-buttons-wrap {
            flex-direction: row; /* Buttons switch to row layout */
            min-width: unset;
            padding: 0; 
            border-bottom: 5px solid var(--color-primary-green, #28a745);
        }
        .bank-tab-button {
            flex: 1;
            text-align: center;
            padding: 12px 10px;
            font-size: 0.95rem;
            justify-content: center; /* Center text and icon */
        }
        .bank-tab-button.active:after {
            content: none; /* Remove right arrow visual on mobile */
        }

        .bank-details-display {
            padding: 30px 20px;
        }
        .detail-item {
            font-size: 0.9rem; /* Further reduced item text size for stacked view */
            padding: 8px 0;
        }
        .detail-item strong {
            font-size: 0.95rem;
            margin-right: 10px;
        }
        .copy-target {
            font-size: 0.9rem;
        }
        .copy-button {
            width: 28px;
            height: 28px;
            font-size: 0.8rem;
        }
        .copy-message.show {
            right: 32px; /* Adjust copied message position */
        }
    }
    
    @media (max-width: 768px) { 
        .bank-transfer-info-section {
            padding: 40px 0; 
        }
        .bank-details-display {
            padding: 20px 15px; /* Tighter padding */
        }
        .bank-details-content h3 {
             font-size: 1.4rem;
             margin-bottom: 15px;
        }
        .details-grid {
             padding: 10px;
        }
        .international-transfer-guidance, .bank-details-content p {
            font-size: 0.9rem;
        }
        /* Since .note is removed, these styles only apply if you manually add back a .note element */
        /* .note {
            padding: 10px;
            margin-top: 20px;
            font-size: 0.85rem;
        } */
    }

    @media (max-width: 480px) { 
        .bank-transfer-info-section {
            padding: 30px 0; 
        }
        .container {
             padding: 0 10px;
        }
        .bank-tab-button {
            font-size: 0.85rem;
            padding: 10px 5px;
        }
        .bank-tab-button i {
            margin-right: 5px;
        }
        .detail-item {
            font-size: 0.85rem;
        }
        .copy-target {
            font-size: 0.8rem;
        }
        .copy-button {
            width: 25px;
            height: 25px;
            font-size: 0.75rem;
        }
        .copy-message {
             font-size: 0.7rem;
        }
    }
</style>

<script is:inline>
    /**
     * Initializes tab switching and copy-to-clipboard functionality, 
     * designed to be safe for Astro View Transitions (soft navigation).
     */
    function initializeBankDetails() {
        // --- 1. Element Selection (MUST be inside this function) ---
        const tabButtons = document.querySelectorAll('.bank-tab-button');
        const contentAreas = document.querySelectorAll('.bank-details-content');
        const copyButtons = document.querySelectorAll('.copy-button');

        // Safety check
        if (tabButtons.length === 0) {
            return;
        }

        // --- 2. Tab Switching Logic ---
        const switchTab = (bankType) => {
            tabButtons.forEach(btn => btn.classList.remove('active'));
            contentAreas.forEach(content => content.classList.remove('active'));

            const activeBtn = document.querySelector(`.bank-tab-button[data-bank="${bankType}"]`);
            const activeContent = document.getElementById(`${bankType}-bank-details`);

            if (activeBtn) activeBtn.classList.add('active');
            if (activeContent) activeContent.classList.add('active');
        };

        // Tab Button Handler (used for adding/removing listeners)
        const tabButtonListener = (event) => {
            const bankType = event.currentTarget.dataset.bank;
            switchTab(bankType);
        };

        // --- 3. Copy-to-Clipboard Logic ---
        // Copy Button Handler (used for adding/removing listeners)
        const copyButtonListener = async (event) => {
            const copyGroup = event.currentTarget.closest('.copy-group');
            const copyTarget = copyGroup.querySelector('.copy-target');
            const copyMessage = copyGroup.querySelector('.copy-message');
            
            if (copyTarget && navigator.clipboard) {
                try {
                    const textToCopy = copyTarget.textContent.trim();
                    await navigator.clipboard.writeText(textToCopy);
                    
                    // Show the 'Copied!' message
                    copyMessage.classList.add('show');

                    setTimeout(() => {
                        copyMessage.classList.remove('show');
                    }, 1500);

                } catch (err) {
                    console.error('Could not copy text: ', err);
                    // Fallback or user notification for copy failure if needed
                }
            } else {
                console.warn('Clipboard API not supported or copy target not found.');
            }
        };


        // --- 4. Listener Management (The Astro View Transition Fix) ---

        // A. Tab Listeners
        tabButtons.forEach(button => {
            // CRITICAL: Remove previous listeners before adding new ones
            button.removeEventListener('click', tabButtonListener); 
            button.addEventListener('click', tabButtonListener);
        });

        // B. Copy Button Listeners
        copyButtons.forEach(button => {
            // CRITICAL: Remove previous listeners before adding new ones
            button.removeEventListener('click', copyButtonListener); 
            button.addEventListener('click', copyButtonListener);
        });

        // C. Initialize the default tab
        switchTab('nepal');
    }

    // --- EXECUTION TRIGGERS ---
    // Ensure initialization runs both on initial load and after soft navigation (Astro View Transitions)
    document.addEventListener('DOMContentLoaded', initializeBankDetails);
    document.addEventListener('astro:page-load', initializeBankDetails);
</script>